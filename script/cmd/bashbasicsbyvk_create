#!/usr/bin/env bash

if [ -z "$1" ]; then
  echo "Usage: create <name>"
  exit 1
fi

if command -v bashbasicsbyvk_ask >/dev/null 2>&1; then type="$(bashbasicsbyvk_ask "Create as (d)irectory or (f)ile? [d/f]: ")"      # THE native line editor
else read -e -p "Create as (d)irectory or (f)ile? [d/f]: " type; fi   # bvk-read-ok: fallback of a broken install (no bashbasicsbyvk_ask)

case "$type" in
  d|D)
    mkdir -p "$1"
    echo "📁 Folder '$1' created."
    ;;
  f|F)
    touch "$1"
    echo "📄 File '$1' created."
    ;;
  *)
    echo "❌ Invalid option. Aborting."
    exit 1
    ;;
esac