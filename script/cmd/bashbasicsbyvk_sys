def safe(func, fallback):
    """A field can never crash the script or show an 'unavailable'-style value."""
    try:
        value = func()
    except Exception:
        value = ""
    return value if good(value) else fallback


def collect():
    usage = safe(cpu_usage, "~0%")
    load = safe(load_average, "")
    activity = f"CPU {usage}" + (f" | Load {load}" if load else "")

    return [
        ("OS", safe(os_info, f"~{SYSTEM or 'Linux'} {MACHINE}")),
        ("Host", safe(host_info, "~Generic device")),
        ("Kernel", safe(kernel_info, f"~{SYSTEM or 'Linux'} (release hidden by OS)")),
        ("Uptime", safe(uptime_info, "~0m")),
        ("Packages", safe(package_info, "~no package manager found")),
        ("Shell", safe(shell_info, "sh")),
        ("Display", safe(display_info, "~No display (headless)")),
        ("WM", safe(window_manager, "~None (TTY/headless)")),
        ("Terminal", safe(terminal_info, "~non-interactive (piped)")),
        ("CPU", safe(cpu_model, f"~{MACHINE} ({cpu_count()} cores)")),
        ("Activity", activity),
        ("Temperature", safe(temperature_info, "~no sensors exposed")),
        ("Memory", safe(memory_info, "~memory size hidden by OS")),
        ("Disk", safe(disk_info, "~storage stats hidden by OS")),
        ("Battery", safe(battery_info, "~battery state unavailable")),
    ]


def main():
    args = sys.argv[1:]
    if args and args[0] in ("-h", "--help"):
        print(__doc__.strip().split("\n\n")[0] + "\n\n" + "\n".join(l for l in __doc__.splitlines() if l.startswith("    bashbasicsbyvk_sys")))
        return
    if args and args[0] == "--device":
        print(device())
        return
    if args:
        print(f"bashbasicsbyvk_sys: unknown option {args[0]} (try --help)", file=sys.stderr)
        sys.exit(2)
    if hasattr(sys.stdout, "reconfigure"):
        try:
            sys.stdout.reconfigure(errors="replace")
        except (ValueError, OSError):
            pass

    if WINDOWS:
        os.system("")  # enables ANSI escape processing in modern Windows consoles
    utf8 = "utf" in (sys.stdout.encoding or "").lower()
    color = sys.stdout.isatty() and "NO_COLOR" not in os.environ and os.environ.get("TERM") != "dumb"
    bold, cyan, dim, reset = ("\033[1m", "\033[96m", "\033[2m", "\033[0m") if color else ("",) * 4

    rows = collect()
    title = f"{user_name()}@{platform.node() or 'localhost'}"
    width = max(36, min(90, max(len(k) + len(v) + 2 for k, v in rows)))

    print()
    print(f"{bold}{title}{reset}")
    print(("─" if utf8 else "-") * width)
    for key, value in rows:
        print(f"{cyan}{key:<14}{reset} {value}")

    if any(value.startswith("~") or " ~" in value or "(~" in value for _, value in rows):
        print()
        print(f"{dim}~ = estimated or inferred: the OS blocks the direct reading.{reset}")


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        print("\nInterrupted.")
