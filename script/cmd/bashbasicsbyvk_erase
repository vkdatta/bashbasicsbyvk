#!/usr/bin/env bash
if [ -z "$1" ]; then
  echo "Usage: erase <filename>"
  exit 1
fi
if [ -f "$1" ]; then
  _yn=3
  if command -v bashbasicsbyvk_yn >/dev/null 2>&1; then      # THE native yes/no menu; the typed question below is only the fallback of a broken install
    bashbasicsbyvk_yn "Erase all contents of '$1'?" -t "Confirm erase" -i "🧹"; _yn=$?
  fi
  case "$_yn" in
    0) confirm=yes ;;
    1|2) confirm=no ;;
    *) echo -n "Erase all contents of '$1'? (yes/no): "
       read -e confirm ;;   # bvk-read-ok: fallback of a broken install (no bashbasicsbyvk_yn)
  esac
  if [ "$confirm" = "yes" ]; then
    > "$1"
    echo "Contents of $1 erased."
  else
    echo "Canceled."
  fi
else
  echo "File '$1' not found."
  exit 1
fi
