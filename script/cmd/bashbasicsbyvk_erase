#!/usr/bin/env bash
if [ -z "$1" ]; then
  echo "Usage: erase <filename>"
  exit 1
fi
# the backup guard (recovery bin / FileAPI backup) and the app's own yes/no menu come from the import file (flat pip install: it sits next to this script on PATH).
# shellcheck disable=SC1090
source "_3bvk_import_cmd_erase.sh" || { echo "❌ Error: cannot load _3bvk_import_cmd_erase.sh (reinstall bashbasicsbyvk)." >&2; exit 1; }
if [ -f "$1" ]; then
  _yn=3
  if command -v bashbasicsbyvk_yn >/dev/null 2>&1; then      # THE native yes/no menu; the typed question below is only the fallback of a broken install
    bashbasicsbyvk_yn "Erase all contents of '$1'?" -t "Confirm erase" -i "🧹"; _yn=$?
  fi
  case "$_yn" in
    0) confirm=yes ;;
    1|2) confirm=no ;;
    *) echo -n "Erase all contents of '$1'? (yes/no): "
       read -e confirm ;;   # bvk-read-ok: fallback of a broken install (no bashbasicsbyvk_yn)
  esac
  if [ "$confirm" = "yes" ]; then
    # erasing is destructive: a backup first (Settings → File API → Backup type).  Nothing to lose in an empty file.
    if [ -s "$1" ]; then _bk_guard erase "$1" || { echo "Canceled."; exit 0; }; fi
    > "$1"
    echo "Contents of $1 erased."
  else
    echo "Canceled."
  fi
else
  echo "File '$1' not found."
  exit 1
fi
