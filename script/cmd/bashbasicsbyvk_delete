#!/usr/bin/env bash
# bashbasicsbyvk_delete <file or folder>
# Used by the file menu's "Delete File". Honours locks (l-N): a locked item
# needs the normal confirmation AND the 6-digit action key.

# lock, action_confirm_key, shortcut registry and the Backup service come from the import file
# (flat pip install: it sits next to this script on PATH).
# shellcheck disable=SC1090
source "_3bvk_import_cmd_delete.sh" || { echo "❌ Error: cannot load _3bvk_import_cmd_delete.sh (reinstall bashbasicsbyvk)." >&2; exit 1; }

# Three questions, one step each (_mc_steps: u = ONE QUESTION BACK, never out of the whole delete):
#   Confirm delete → the 6-digit key (locked items only) → Back up before deleting.     They share _bvk_delete_main's locals (target confirm).
_bd_confirm() {
  local _yn=3
  if command -v bashbasicsbyvk_yn >/dev/null 2>&1; then      # THE native yes/no menu; the typed question below is only the fallback of a broken install
    bashbasicsbyvk_yn "Are you sure you want to delete '$target'? You may not recover this." -t "Confirm delete" -i "🗑️" -b; _yn=$?
  fi
  case "$_yn" in
    0) return 0 ;;
    4) return 1 ;;                                           # u: the file menu again
    1|2) echo "Deletion cancelled."; return 3 ;;
    *) echo "Are you sure you want to delete '$target'? You may not recover this."
       read -e -p "Type 'yes' to confirm: " confirm
       [ "$confirm" = "yes" ] && return 0
       echo "Deletion cancelled."; return 3 ;;
  esac
}
_bd_lock() {
  _lk_is_protected "$target" || return 5
  local -a detail=()
  local rc
  if _lk_is_locked "$target"; then
    detail+=("🔒 You selected a LOCKED $( [ -d "$target" ] && echo folder || echo file ): ${target##*/}")
  else
    _lk_count_inside "$target"
    detail+=("🔒 This folder holds $_lk_inside locked item(s): ${target##*/}")
  fi
  detail+=("Deleting it will erase its content PERMANENTLY if a backup has not been taken.")
  action_confirm_key "LOCKED ITEM — confirmation required" "${detail[@]}"; rc=$?
  (( rc == 0 )) && return 0
  (( rc == 2 )) && return 1
  echo "🚫 Deletion cancelled — locked item kept"; return 3
}
_bd_backup() {
  local rc
  _bk_before_delete "$target"; rc=$?                         # Backup service (Settings → File API → Backup): a failed backup asks before deleting
  (( rc == 0 )) && return 0
  (( rc == 6 )) && return 1
  return 3
}

_bvk_delete_main() {
  local target="$1" confirm
  if [ -z "$target" ]; then
    echo "Usage: delete <filename or folder>"
    return 1
  fi

  if [ ! -e "$target" ] && [ ! -L "$target" ]; then
    echo "File or directory not found: $target"
    return 1
  fi

  _lk_load
  _mc_steps _bd_confirm _bd_lock _bd_backup || return 0

  rm -rf -- "$target" && { _lk_forget "$target"; _scr_forget_under "$target"; }
  echo "Deleted: $target"
}

_bvk_delete_main "$@"
