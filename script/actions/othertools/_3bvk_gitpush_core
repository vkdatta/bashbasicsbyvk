#!/usr/bin/env bash

TARGET="${1:-$(pwd)}"
cd "$TARGET" || { echo "❌ Cannot cd to $TARGET"; exit 1; }

REPO_NAME="$(basename "$TARGET")"

# --- CHECK IF GIT REPO EXISTS ---
if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    echo "🚨 Are you sure you want to push this to GitHub with repo name: '$REPO_NAME'?"
    read -rp "Type 'yes' or 'no': " CONFIRM

    if [[ "$CONFIRM" != "yes" ]]; then
        echo "❌ Operation cancelled."
        exit 1
    fi

    # Generate a random 6-digit code
    CODE=$((100000 + RANDOM % 900000))
    echo "🔒 Security Verification: Type this code to continue: $CODE"
    read -rp "Enter 6-digit code: " USER_CODE

    if [[ "$USER_CODE" != "$CODE" ]]; then
        echo "❌ Incorrect code. Aborting setup."
        exit 1
    fi

    echo "⚙️ Initializing new Git repository..."
    git init
    git branch -M main
    
    git add .
    git commit -m "New Initial Commit"

    echo "🚀 Creating remote repository on GitHub..."
    # Requires GitHub CLI (gh) logged in via 'gh auth login'
    gh repo create "$REPO_NAME" --public --source=. --remote=origin --push
    
    echo "✅ Successfully created and pushed '$REPO_NAME' to GitHub!"
    exit 0
fi

# --- EXISTING GIT REPO WORKFLOW ---
git add .

if git diff --cached --quiet; then
    echo "⚠️ No changes staged to commit."
    exit 0
fi

echo "--- 🛠️ Git Commit & Tag Helper ---"

read -rp "Enter commit message [Default: Codebase Updated]: " USER_MSG
MSG="${USER_MSG:-Codebase Updated}"

echo ""
echo "Select version bump type:"
echo "1) Patch  (e.g., 0.0.1 -> 0.0.2) [DEFAULT]"
echo "2) Minor  (e.g., 0.1.0 -> 0.2.0)"
echo "3) Major  (e.g., 1.0.0 -> 2.0.0)"
read -rp "Enter choice [1-3, Default: 1]: " CHOICE

case "$CHOICE" in
    2) TAG="#minor" ;;
    3) TAG="#major" ;;
    1|"") TAG="#patch" ;;
    *)
        echo "⚠️ Invalid option selected. Defaulting to #patch."
        TAG="#patch"
        ;;
esac

FINAL_MSG="$MSG $TAG"

echo ""
echo "🚀 Committing with message: \"$FINAL_MSG\""
git commit -m "$FINAL_MSG"

echo "⬆️ Pushing to remote..."
git push
