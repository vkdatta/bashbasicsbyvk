#!/usr/bin/env bash

# THE LOAD MAPPER (AGENTS.md rule 13): the first file o loads. It reads bashbasicsbyvk_loadmap.list before anything else is loaded, and
# loads only what that list says: [fg] now (what the first paint needs), [bg] after the paint (_lm_idle, below), [no] only when called.
source "bashbasicsbyvk_loadmap.sh"
_lm_fg || exit 1

# Inner-loop driver: sw, fx, r (the .r rule book), upg (the -u upgrade loop), api (the link manager), pn (Pending uploads), bk (Backup), sv (Saved Surf), sn (Snapshots), rbam, nf (notifications) and cs (cloud surf) hand over to each other via _inner_next,
# while the outer main loop stays untouched.
_inner_next=""
_inner_run() {
  local _next="$1"
  while [ -n "$_next" ]; do
    _inner_next=""
    case "$_next" in
      sw) switch_menu ;;
      fx) functions_menu ;;
      r)  rules_menu ;;
      upg) upgrade_menu ;;
      api) api_menu ;;
      pn)  pending_menu ;;
      bk)  backup_menu ;;
      sv)  saved_menu ;;
      sn)  snapshot_menu ;;
      rbam) rbam_menu ;;
      nf)  notify_menu ;;
      cs)  csurf_menu ;;
      cs-recv) csurf_menu 1 ;;
      gdp) gdrive_profiles_menu ;;
    esac
    [ "${_BVK_TO_MAIN:-0}" = 1 ] && break      # q somewhere inside: close to the main loop (u only ever goes back one screen)
    _next="$_inner_next"
  done
}

_bvk_d="${BASH_SOURCE[0]}"; case "$_bvk_d" in */*) _bvk_d="${_bvk_d%/*}" ;; *) _bvk_d=. ;; esac   # no dirname process
SCRIPT_DIR="$(cd -- "$_bvk_d" && pwd)"; unset _bvk_d

_lt_b "start: dependencies"
command -v python3 >/dev/null 2>&1 || { _lm_need bashbasicsbyvk_deps.sh; _dep_need -c "Starting the app" app.core || exit 1; }   # python3: only when it is missing does the central registry (bashbasicsbyvk_deps.list) load and offer to install it
_lt_e
_lt_b "start: recents daemon check";  _bvk_wake_recents_daemon; _lt_e
# the usage ping and the snapshot daemon start after the first paint: the @call lines of [bg] in bashbasicsbyvk_loadmap.list
_lt_b "start: terminal colours + screen setup"; _disp_startup; _lt_e
_lt_b "start: engines fit this machine?"; _bvk_engine_heal "$@"; _lt_e   # install made on another CPU / OS: offer a reinstall

trap '[ "${_GD_ACTIVE:-0}" = 1 ] && _gd_on_exit 2>/dev/null; _lt_cleanup; _bvk_paste_off 2>/dev/null; _bvk_mouse_off 2>/dev/null; stty "$_orig_stty" 2>/dev/null; \
      [ -n "$path" ] && printf "%s" "$path" > "$_BVK_LASTDIR_FILE"; \
      [ -n "${_BVK_DSIZE_TMP:-}" ] && rm -rf "$_BVK_DSIZE_TMP" 2>/dev/null; \
      true' EXIT

_orig_stty=$(stty -g 2>/dev/null)

# command map tooling:  o --map-show [menu] · o --map-lint · o --map-doc · o --map-gen
case "${1:-}" in
  --map-show) _lm_all; _cm_show "${2:-main}"; exit $? ;;
  --map-lint) _lm_all; _cm_lint; exit $? ;;
  --map-doc)  _lm_all; _cm_doc; exit $? ;;
  --map-gen)  _mg=$(_cm_find bashbasicsbyvk_mapgen) && exec python3 "$_mg" "${@:2}"; echo "mapgen not found"; exit 1 ;;
esac

_lt_mark "startup finished — entering the main loop"
if [ $# -eq 1 ]; then
  target="$1"
  if [ -d "$target" ]; then
    path=$(get_abs_path "$target")
  elif [ -f "$target" ]; then
    selected=$(get_abs_path "$target")
    _lm_need bashbasicsbyvk_run.sh; handle_file "$selected"; _o_rc=$?
    [ "${_BVK_GO_PARENT:-0}" = 1 ] || exit $_o_rc     # "Go To Parent Folder": carry on in the main loop, in that folder
    _BVK_GO_PARENT=0
  else
    echo "❌ Error: '$target' not found" >&2
    exit 1
  fi
fi

shopt -s nullglob
while true; do
  _BVK_TO_MAIN=0                                 # we ARE the main loop: a q from a menu / flow has arrived
  declare -F _cm_abort_clear >/dev/null 2>&1 && _cm_abort_clear
  [ "${_GD_ACTIVE:-0}" = 1 ] && { _lt_b "gdrive: sync cycle"; _gd_cycle; _lt_e; }     # Google Drive open: push what the last command changed, list this folder
  declare -F _sm_reset >/dev/null 2>&1 && _sm_reset
  _lt_b "count items in this folder"; total=$(count_items_in_path "$path"); _lt_e

  imaginary_mode=false
  _filter_reset_state
  items=()
  _hl_index=0

  _has_group_view=false
  [ "${#group_view_levels[@]}" -gt 0 ] && _has_group_view=true

  _lt_b "read display filter / selection / favourites"
  _disp_begin   # .d display filter: sets _disp_on
  _sel_begin    # selection count for the header (marks are drawn by the viewport)
  _fav_begin    # favourites: sets _fav_on (mode priority: favourite > imaginary > normal)
  _lt_e

  _lt_b "build the item list ($total items)"
  if $_fav_on; then
    _fav_build_items
  elif [ "$total" -gt "${index_mode_threshold:-200}" ] && ! $force_show && ! $_disp_on; then
    imaginary_mode=true
    if [ -n "$group_prefix" ]; then
      _bvk_load_prefix_items "$path" "$group_prefix"; local_arr=("${items[@]}"); items=()
      pfx_count="${#local_arr[@]}"
      if [ "$pfx_count" -le "${index_mode_threshold:-200}" ]; then
        imaginary_mode=false
        items=("${local_arr[@]}")
        _collect_metadata
        apply_sort
      else
        build_imaginary_groups "$path" "$group_prefix" "$pfx_count"
      fi
    else
      build_imaginary_groups "$path" "" "$total"
    fi
  elif [ "$total" -gt "${index_mode_threshold:-200}" ] && { $force_show || $_disp_on; }; then
    imaginary_mode=false
    build_items_with_meta "$path" "$group_prefix"
    apply_sort
  fi

  if ! $imaginary_mode; then
    if [ ${#items[@]} -eq 0 ]; then
      build_items_with_meta "$path" "$group_prefix"
      apply_sort
    fi
  fi

  _lt_e
  _lt_b "apply filters / drive order / group view"
  $imaginary_mode || _disp_apply   # narrow to the .d display filter
  $imaginary_mode || [ "${_GD_ACTIVE:-0}" != 1 ] || _gd_order_items   # Google Drive: folders first, like drive.google.com
  # Group view: breadcrumb drill (menu of groups, then the files of the picked group)
  _gv_crumb_menu=false; _gv_leaf=false
  $imaginary_mode || $_fav_on || _gv_crumb_apply
  _lt_e

  if $imaginary_mode; then
    _vp_mode="imaginary"
    _vp_header_fn=_menu_header_imaginary
  else
    _vp_mode="items"
    _vp_header_fn=_menu_header_flat
  fi
  _vp_footer_fn=_menu_footer_lines
  _vp_hl_fn=_vp_is_hl_single
  _msel_set=()
  _vp_input_fn=_print_input_line
  _vp_start=1
  # The file list is always drawn by display_items. An inner loop (fx, smartmenu)
  # may have left its own row renderer set, which would replace the file rows.
  _vp_rowtext_fn=""
  _vp_cache_reset
  _lt_b "draw the menu"
  _vp_prime_rows
  _vp_render_fresh
  _lt_e

  _lm_idle      # [bg] of the load mapper: one file at a time, only while no key is waiting
  _read_choice_filtered
  _lt_mark "dispatch: ${choice:-?}"

  shopt -s nocasematch
  case "$choice" in
    q)           if ${_sw_did_switch:-false}; then [ "${_GD_ACTIVE:-0}" = 1 ] && _gd_before_exec; _lt_cleanup; cd "$path" && exec "$SHELL"; else exit 0; fi ;;   # q on the main loop = leave the app
    -h)          open_help ;;
    h)           home_menu ;;
    __navpath__) [ -d "${_BVK_NAV_TARGET:-}" ] && { path="$_BVK_NAV_TARGET"; group_prefix=""; force_show=false; }; _BVK_NAV_TARGET="" ;;   # a folder name of the nav path was touched (bashbasicsbyvk_mouse.sh)
    u)           if [ "${_GD_ACTIVE:-0}" = 1 ] && _gd_at_root; then echo "☁️  This is the top of your Google Drive — gdx leaves it"
                 elif [ -n "$group_prefix" ]; then
                   group_prefix="${group_prefix%?}"; force_show=false
                 elif [ "${#_gv_crumbs[@]}" -gt 0 ]; then
                   unset '_gv_crumbs[-1]'       # Group view: back up one crumb
                 elif [ "$path" != "/" ]; then
                   path=$(dirname "$path"); group_prefix=""; force_show=false
                 fi ;;
    fs|forceshow) handle_force_show_guarded ;;
    ns)          handle_normal_show ;;
    fa|fa\ *)    handle_fav_add "$choice" ;;
    c)           handle_create ;;
    t)           transfer_menu ;;
    d)           delete_items ;;
    l-*)         handle_lock_items "$choice" ;;
    ul-*)        handle_unlock_items "$choice" ;;
    f)           find_menu ;;
    z)           organise_menu ;;
    s)           settings_menu ;;
    r)           handle_rename ;;
    cd)          if [ "${_GD_ACTIVE:-0}" = 1 ]; then echo "☁️  A shell inside the Drive mirror would see empty placeholders — leave with gdx first (or use t to copy out)"; else _lt_cleanup; cd "$path" && exec "$SHELL"; fi ;;
    goto|goto\ *) handle_goto "$choice" ;;
    kl)          kill -9 -1 ;;
    i)           infinity_stones_menu ;;
    -u)          _inner_run upg ;;
    d-|d-\ *)    handle_staging_dispatch "${choice:2}" ;;
    v-)          handle_staging_view ;;
    p-*)         handle_staging_map "$choice" ;;
    c-*|m-*|k-*|b-*|s-*)  handle_staging_stage "$choice" ;;
    do-)         handle_do_import ;;
    c2c-*)       handle_c2c_upload "$choice" ;;
    up-*)        handle_up_upload "$choice" ;;
    eb-*)        handle_eb "$choice" ;;
    ux-*)        handle_ux_upload "$choice" ;;
    save-*)      handle_save_upload "$choice" ;;
    snap-*)      handle_snap_add "$choice" ;;
    uz-*)        handle_decompress_items "$choice" ;;
    z-*)         handle_compress_items "$choice" ;;
    clear)       hash -r ;;
    =*)          ;;
    health)      bvk_health ;;
    lang)        bvk_lang ;;
    disk)        df -h ;;
    ram)         free -h ;;
    rf)          if [ "${_GD_ACTIVE:-0}" = 1 ]; then _gd_refresh "$path"; else handle_refresh; fi ;;
    scr-sync)    handle_scr_sync ;;
    sast)        bashbasicsbyvk_sast ;;
    .s|.s.*|.s\ *|.us|.us.*|.us\ *|.r|.r.*|.r\ *)  handle_select_cmd "$choice" ;;
    -auth)       auth_menu ;;
    .ai|.ai\ *)  handle_ai_cmd "$choice" ;;
    .dm|.dm.*)   handle_daemon_cmd "$choice" ;;
    .d|.d.*|.d\ *)  handle_display_cmd "$choice" ;;
    gd|gd.*|gdx) handle_gd_cmd "$choice" ;;
    sw)          _inner_run sw ;;
    fx)          _inner_run fx ;;
    api)         _inner_run api ;;
    pn)          _inner_run pn ;;
    bk)          _inner_run bk ;;
    sv)          _inner_run sv ;;
    sn)          _inner_run sn ;;
    rbam)        _inner_run rbam ;;
    nf)          _inner_run nf ;;
    cs)          _inner_run cs ;;
    *)           handle_selection "$choice" ;;
  esac
done
