def cmd_create_release(args):
    job = _job(args); repo = job.repo
    tag = job.get("tag").strip()
    bad_name = valid_tag_name(tag)
    if bad_name:
        bad("%s: %s" % (tag or "(empty)", bad_name)); return 1
    if tag in releases_by_tag(repo):
        bad("a release for '%s' already exists in %s" % (tag, repo)); return 1
    title, body, msg = job.get("title").strip(), job.get("body"), job.get("tag_message")
    st = tag_state(repo, tag)
    payload = {"tag_name": tag, "name": title or tag, "body": body, "draft": False, "prerelease": False}
    if st:
        note("tag %s exists - the release is attached to it" % tag)
        if msg.strip():
            note("(the tag message of an existing tag is changed with edit, not here)")
    else:
        target = _default_target(repo, job.get("target").strip())
        sha = _resolve_commit(repo, target)
        if msg.strip():
            write_tag(repo, tag, sha, msg)                    # annotated tag first, then the release picks it up
            note("created annotated tag %s at %s" % (tag, sha[:10]))
        else:
            payload["target_commitish"] = target
    r = http("POST", "/repos/%s/releases" % repo, payload)
    ok("created stable release %s  %s" % (tag, r.get("html_url", "")))
    return 0


def _edit_one(repo, tag, specs, st, rel, move_branch):
    """apply the given text transforms to one tag/release; returns (changes[str], problems[str])"""
    changes, problems = [], []
    new_commit, new_msg, rel_patch = None, None, {}
    tm, cm = specs.get("tag_message"), specs.get("commit_message")
    if cm:
        if not st:
            problems.append("no git tag - commit message not changed")
        else:
            c = http("GET", "/repos/%s/git/commits/%s" % (repo, st["commit_sha"]))
            text, why = apply_text(c.get("message") or "", *cm)
            if why:
                problems.append("commit message: " + why)
            elif text == (c.get("message") or ""):
                problems.append("commit message: already that text")
            else:
                nc = http("POST", "/repos/%s/git/commits" % repo, {
                    "message": text, "tree": c["tree"]["sha"], "parents": [p["sha"] for p in c.get("parents", [])],
                    "author": c.get("author"), "committer": c.get("committer")})
                new_commit = nc["sha"]
                changes.append("commit message (new commit %s - the old one is %s)" % (nc["sha"][:10], st["commit_sha"][:10]))
    if tm:
        if not st:
            problems.append("no git tag - tag message not changed")
        else:
            text, why = apply_text(st["message"], *tm)
            if why:
                problems.append("tag message: " + why)
            elif st["annotated"] and text == st["message"]:
                problems.append("tag message: already that text")
            else:
                new_msg = text
                changes.append("tag message" + ("" if st["annotated"] else " (the lightweight tag became annotated)"))
    if new_commit or new_msg is not None:
        write_tag(repo, tag, new_commit or st["commit_sha"], new_msg, st)
        if new_commit and move_branch:
            moved = 0
            for r in http("GET", "/repos/%s/git/matching-refs/heads" % repo):
                if r["object"]["sha"] == st["commit_sha"]:
                    http("PATCH", "/repos/%s/git/refs/heads/%s" % (repo, q(r["ref"][len("refs/heads/"):])), {"sha": new_commit, "force": True})
                    moved += 1
            changes.append("moved %d branch(es) to the new commit" % moved if moved else "no branch ends at the old commit - no branch moved")
    for f, key in (("title", "name"), ("body", "body")):
        sp = specs.get(f)
        if not sp:
            continue
        if not rel:
            problems.append("no release - %s not changed" % ("title" if f == "title" else "notes")); continue
        text, why = apply_text(rel.get(key) or "", *sp)
        if why:
            problems.append("%s: %s" % ("title" if f == "title" else "notes", why))
        elif text == (rel.get(key) or ""):
            problems.append("%s: already that text" % ("title" if f == "title" else "notes"))
        else:
            rel_patch[key] = text
            changes.append("title" if f == "title" else "notes")
    if rel_patch:
        http("PATCH", "/repos/%s/releases/%d" % (repo, rel["id"]), rel_patch)
    return changes, problems


def cmd_edit(args):
    job = _job(args); repo = job.repo
    tags = job.lines("tags")
    specs = {f: job.spec(f) for f in FIELDS if job.spec(f)}
    if not tags or not specs:
        bad("nothing to edit"); return 3
    rels = releases_by_tag(repo)
    fails = 0
    for tag in tags:
        try:
            st = tag_state(repo, tag)
            if not st and tag not in rels:
                raise GhError("not found", 404)
            changes, problems = _edit_one(repo, tag, specs, st, rels.get(tag), job.flag("move_branch"))
            if changes:
                ok("%s: changed %s" % (tag, ", ".join(changes)))
            for p in problems:
                note("%s: %s" % (tag, p))
            if not changes and not problems:
                note("%s: nothing to do" % tag)
        except GhError as e:
            fails += 1; bad("%s: %s" % (tag, e))
    return 1 if fails else 0


def _rename_pairs(job, tags):
    mode, a, b = job.get("rule.mode").strip(), job.get("rule.a"), job.get("rule.b")
    pairs = []
    if mode == "manual":
        m = dict(l.split("\t", 1) for l in job.lines("map") if "\t" in l)
        return [(t, m.get(t, t)) for t in tags]
    for t in tags:
        if mode == "prefix":    n = a + t
        elif mode == "suffix":  n = t + a
        elif mode == "replace": n = t.replace(a, b) if a else t
        elif mode == "regex":
            try:
                n = re.sub(a, b, t)
            except re.error as e:
                raise GhError("bad pattern: %s" % e, 2)
        else:
            raise GhError("unknown rename rule '%s'" % mode, 2)
        pairs.append((t, n))
    return pairs


def _rename_one(repo, old, new, rel, retitle):
    ref = get_ref(repo, old)
    if not ref:
        raise GhError("tag '%s' not found" % old, 404)
    o = ref["object"]
    if o["type"] == "tag":                                  # the tag object carries its own name: make a new one for the new name
        t = http("GET", "/repos/%s/git/tags/%s" % (repo, o["sha"]))
        n = http("POST", "/repos/%s/git/tags" % repo, {"tag": new, "message": t.get("message") or "", "object": t["object"]["sha"],
                                                       "type": t["object"]["type"], "tagger": t.get("tagger") or my_identity()})
        create_ref(repo, new, n["sha"])
    else:
        create_ref(repo, new, o["sha"])
    if rel:
        patch = {"tag_name": new}
        if retitle and (rel.get("name") or "") == old:
            patch["name"] = new
        try:
            http("PATCH", "/repos/%s/releases/%d" % (repo, rel["id"]), patch)
        except GhError:
            try:
                delete_ref(repo, new)                        # undo: nothing half-renamed
            except GhError:
                pass
            raise
    try:
        delete_ref(repo, old)
    except GhError as e:
        raise GhError("'%s' now exists, but the old '%s' could not be removed (%s)" % (new, old, e), e.status)


def cmd_rename(args):
    job = _job(args); repo = job.repo
    tags = job.lines("tags")
    if not tags:
        bad("nothing selected"); return 3
    try:
        pairs = _rename_pairs(job, tags)
    except GhError as e:
        bad(str(e)); return 2
    refs = {t for t, _, _ in list_tag_refs(repo)}
    rels = releases_by_tag(repo)
    for t in tags:                                           # an item must exist: as a tag, or as a release whose tag exists
        if t not in refs:
            bad("%s: no such tag in %s" % (t, repo)); return 3
    steps, notes, errors = plan_renames(pairs, refs, set(rels))
    for n in notes:
        note(n)
    if errors:
        print("🔴 %d naming problem(s) - nothing was renamed:" % len(errors))
        for e in errors:
            print("   ❌ " + e)
        return 1
    if not steps:
        note("nothing to rename"); return 3
    if "--plan" in args:
        for o, n in pairs:
            if o != n:
                print("   %s  ->  %s%s" % (o, n, "   (release follows)" if o in rels else ""))
        hops = sum(1 for _, _, t in steps if t)
        if hops:
            print("   (%d name(s) swap places: a temporary name is used for a moment)" % hops)
        return 0
    fails, retitle = 0, job.get("retitle", "1").strip() != "0"
    for o, n, tmp in steps:                                  # steps carry the CURRENT name of each item (a parked item has its temp name)
        try:
            _rename_one(repo, o, n, rels.get(o), retitle)
            r = rels.pop(o, None)
            if r:                                            # keep the local release map in step with GitHub
                r["tag_name"] = n
                if retitle and (r.get("name") or "") == o:
                    r["name"] = n
                rels[n] = r
            if not tmp:
                ok("%s -> %s" % (o, n))
        except GhError as e:
            fails += 1; bad("%s -> %s: %s" % (o, n, e))
            if tmp:                                          # a parked item could not be parked: the later steps would be wrong
                bad("stopped: the remaining renames of this swap were not attempted"); break
    return 1 if fails else 0


def cmd_delete(args):
    job = _job(args); repo = job.repo
    tags = job.lines("tags")
    do_rel, do_tag = job.flag("release"), job.flag("tag")
    if not tags or not (do_rel or do_tag):
        bad("nothing to delete"); return 3
    rels = releases_by_tag(repo)
    fails = 0
    for t in tags:
        try:
