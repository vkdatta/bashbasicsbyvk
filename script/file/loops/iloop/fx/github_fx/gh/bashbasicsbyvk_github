def _git_version():
    try:
        m = re.search(r'(\d+)\.(\d+)', subprocess.run(["git", "--version"], capture_output=True, text=True).stdout)
        return (int(m.group(1)), int(m.group(2)))
    except Exception:
        return (0, 0)


def _git_env():
    """the key reaches git through its environment only (never argv, never a file git keeps)"""
    env = dict(os.environ, GIT_TERMINAL_PROMPT="0")
    cleanup = None
    if not GIT_BASE.startswith("https://") and not GIT_BASE.startswith("http://"):
        return env, None
    tok = _token()
    if _git_version() >= (2, 31):
        hdr = "Authorization: Basic " + base64.b64encode(("x-access-token:" + tok).encode()).decode()
        env.update(GIT_CONFIG_COUNT="1", GIT_CONFIG_KEY_0="http.extraHeader", GIT_CONFIG_VALUE_0=hdr)
    else:                                                    # old git: a private askpass helper
        fd, p = tempfile.mkstemp(prefix="bvk_askpass_")
        os.write(fd, ("#!/bin/sh\ncase \"$1\" in Username*) echo x-access-token ;; *) echo '%s' ;; esac\n" % tok).encode()); os.close(fd)
        os.chmod(p, 0o700); env.update(GIT_ASKPASS=p); cleanup = p
    return env, cleanup


def safe_name(s):
    return re.sub(r'[^\w.+-]+', "_", s).strip("_") or "x"


def unique_dir(parent, base):
    p, n = os.path.join(parent, base), 1
    while os.path.exists(p):
        n += 1; p = os.path.join(parent, "%s-%d" % (base, n))
    return p


def _download_asset(repo, asset, dest):
    data = http("GET", "/repos/%s/releases/assets/%d" % (repo, asset["id"]), accept="application/octet-stream")
    with open(dest, "wb") as fh:
        fh.write(data if isinstance(data, bytes) else json.dumps(data).encode())


def _fetch_release(repo, rel, base):
    d = unique_dir(os.path.dirname(base), os.path.basename(base) + "-release")
    os.makedirs(d)
    with open(os.path.join(d, "release.md"), "w", encoding="utf-8") as fh:
        fh.write("# %s\n\ntag: %s\npublished: %s\n\n%s\n" % (rel.get("name") or rel["tag_name"], rel["tag_name"],
                 (rel.get("published_at") or rel.get("created_at") or "")[:10], (rel.get("body") or "").replace("\r", "")))
    n = 0
    for a in rel.get("assets") or []:
        _download_asset(repo, a, os.path.join(d, safe_name(a["name"]) if safe_name(a["name"]) != "x" else "asset-%d" % a["id"]))
        n += 1
    return d, n


def cmd_clone(args):
    job = _job(args); repo = job.repo
    tags = job.lines("tags")
    dest = job.get("dest").strip() or "."
    depth = job.get("depth").strip()
    depth = int(depth) if depth.isdigit() and int(depth) > 0 else 0
    with_rel = job.flag("with_release")
    if not tags:
        bad("nothing to download"); return 3
    if shutil.which("git") is None:
        try:
            import bashbasicsbyvk_deps as _deps
            _deps.ensure("git", context="GitHub download")
        except ImportError:
            pass
    if shutil.which("git") is None:
        bad("git is not installed"); return 1
    os.makedirs(dest, exist_ok=True)
    rels = releases_by_tag(repo) if with_rel else {}
    env, cleanup = _git_env()
    url = "%s/%s.git" % (GIT_BASE, repo)
    fails = 0
    try:
        for t in tags:
            target = unique_dir(dest, "%s-%s" % (repo.split("/")[1], safe_name(t)))
            try:
                if depth:
                    cmds = [["git", "init", "-q", target], ["git", "-C", target, "remote", "add", "origin", url],
                            ["git", "-C", target, "fetch", "--depth", str(depth), "origin", "+refs/tags/%s:refs/tags/%s" % (t, t)],
                            ["git", "-C", target, "-c", "advice.detachedHead=false", "checkout", "-q", "--detach", "refs/tags/" + t]]
                else:
                    cmds = [["git", "clone", "--no-checkout", url, target],
                            ["git", "-C", target, "-c", "advice.detachedHead=false", "checkout", "-q", "--detach", "refs/tags/" + t]]
                for c in cmds:
                    r = subprocess.run(c, env=env, stdout=subprocess.DEVNULL)       # stderr stays on the terminal: git's progress and errors
                    if r.returncode:
                        shutil.rmtree(target, ignore_errors=True)
                        raise GhError("git failed (exit %d) - see git's message above" % r.returncode)
                extra = ""
                if with_rel:
                    if t in rels:
                        d, n = _fetch_release(repo, rels[t], target)
                        extra = "  + release notes and %d asset(s) in %s" % (n, d)
                    else:
                        extra = "  (no release for this tag)"
                ok("%s -> %s  [%s]%s" % (t, target, "depth %d" % depth if depth else "full history", extra))
            except GhError as e:
                fails += 1; bad("%s: %s" % (t, e))
    finally:
        if cleanup:
            try: os.unlink(cleanup)
            except OSError: pass
    return 1 if fails else 0


