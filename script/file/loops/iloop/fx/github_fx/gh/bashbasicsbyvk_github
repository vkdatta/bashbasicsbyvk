    if get_ref(repo, tag) or tag in releases_by_tag(repo):
        bad("'%s' already exists in %s" % (tag, repo)); return 1
    sha = _resolve_commit(repo, _default_target(repo, job.get("target").strip()))
    msg = job.get("tag_message")
    write_tag(repo, tag, sha, msg if msg.strip() else None)
