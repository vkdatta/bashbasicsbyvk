def cmd_auth(args):
    global _TOKEN
    cands, looked = key_candidates()
    if not cands:
        print(US.join(["NONE"] + looked)); return 5
    last = ""
    for i, (tok, where) in enumerate(cands):
        _TOKEN = tok
        try:
            u = whoami()
            print(US.join(["OK", u.get("login") or "", where, str(i)])); return 0
        except GhError as e:
            last = "%s: %s" % (where, e)
            if e.status not in (401, 403):
                print(US.join(["ERR", str(e)])); return 1
    print(US.join(["REJECTED", last])); return 5


