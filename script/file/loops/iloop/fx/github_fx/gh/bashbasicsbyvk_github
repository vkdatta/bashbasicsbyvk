def _default_target(repo, target):
    if target:
        return target
    return http("GET", "/repos/%s" % repo).get("default_branch") or "main"


def _resolve_commit(repo, target):
    """branch name / tag / sha -> commit sha"""
    try:
        return http("GET", "/repos/%s/commits/%s" % (repo, q(target)))["sha"]
    except GhError as e:
        raise GhError("cannot find '%s' in %s (%s)" % (target, repo, e), 404)


def cmd_create_tag(args):
