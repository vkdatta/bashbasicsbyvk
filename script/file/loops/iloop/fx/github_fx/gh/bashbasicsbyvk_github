                    http("DELETE", "/repos/%s/releases/%d" % (repo, r["id"])); ok("%s: release deleted" % t)
                else:
                    note("%s: no release to delete" % t)
            if do_tag:
                if get_ref(repo, t):
                    delete_ref(repo, t); ok("%s: tag deleted" % t)
                else:
                    note("%s: no tag to delete" % t)
        except GhError as e:
            fails += 1; bad("%s: %s" % (t, e))
    return 1 if fails else 0


