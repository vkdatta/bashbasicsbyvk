def cmd_remotes(args):
    types = {t.strip() for t in os.environ.get("BVK_GD_TYPES", "drive").split(",") if t.strip()}
    cmd = [RCLONE, "--ask-password=false", "config", "dump"]
    try:
        p = subprocess.run(cmd, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
    except FileNotFoundError:
        say("rclone is not installed")
        return 2
    if p.returncode != 0:
        say("rclone config could not be read: " + ((p.stderr or "").strip().splitlines() or ["?"])[-1])
        return 2
    try:
        data = json.loads(p.stdout or "{}")
    except ValueError:
        say("rclone config dump is not JSON")
        return 2
    for name in sorted(data, key=str.lower):
        t = (data[name] or {}).get("type", "")
        if t in types:
            print(f"{name}\t{t}")
    return 0


def cmd_sync(ctx, args):
    db = DB(ctx)
    rel = ctx.rel(args.path) if args.path else ""
    bar = Bar(f"Loading {ctx.remote}:/{rel} from Google Drive").start()
    ctx.bar = bar
    try:
        st = sync_dir(ctx, db, rel, force=args.force, recursive=args.recursive)
    finally:
        bar.stop()
    if st.get("dups"):
        say(f"🔴  {st['dups']} item(s) share a name with another item in this Drive folder and are hidden "
            f"(rclone dedupe {ctx.remote}:{rel} fixes that).")
    return 0


def cmd_status(ctx, args):
