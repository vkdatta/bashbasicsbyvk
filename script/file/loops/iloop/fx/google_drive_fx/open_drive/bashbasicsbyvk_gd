#  hydrate / clean
# ══════════════════════════════════════════════════════════════════════════════════════════════
def pending_files(db, rels):
    out = {}
    for rel in rels:
        row = db.get(rel)
        if row is None:
            continue
        if row["kind"] == "f":
            if not row["hyd"]:
                out[rel] = row
        else:
            for r in db.under(rel):
                if r["kind"] == "f" and not r["hyd"]:
                    out[r["rel"]] = r
    return out


def cmd_hydrate(ctx, args):
    db = DB(ctx)
    rels = []
    for p in args.paths:
        rel = ctx.rel(p)
        rels.append(rel)
    bar = Bar("Preparing the list of files").start()
    ctx.bar = bar
    try:
        for rel in rels:
            row = db.get(rel)
            if row is not None and row["kind"] == "d":
                sync_dir(ctx, db, rel, force=True, recursive=True)          # know every file below the folder
        todo = pending_files(db, rels)
    finally:
        bar.stop()
    if not todo:
        return 0
    total = sum(max(r["size"], 0) for r in todo.values())
    limit = int(os.environ.get("BVK_GD_CONFIRM_MB", "200")) * 1024 * 1024
    if total > limit:
        if not ask_yes(f"☁️  Download {len(todo)} file(s), {fmt_size(total)} from Google Drive first?"):
            say("🚫 Cancelled — nothing downloaded.")
            return 4
    stage = tempfile.mkdtemp(prefix="dl-", dir=ctx.tmp)
    listing = os.path.join(stage, ".files")
    with open(listing, "w") as fh:
        fh.write("\n".join(todo) + "\n")
    show = f"Downloading {len(todo)} file(s) · {fmt_size(total)} from Google Drive"
    bar = Bar(show).start()
    try:
        big = total >= 1 << 20 and sys.stderr.isatty()
        args2 = ["copy", ctx.rpath(""), os.path.join(stage, "data"), "--files-from-raw", listing]
        if big:
            args2 += ["--progress"]
            with bar.paused():
                rc, _, err = rclone(ctx, args2, check=False, passthrough=True)
        else:
            rc, _, err = rclone(ctx, args2, check=False)
        failed = []
        touched = {}
        for rel, row in todo.items():
            src = os.path.join(stage, "data", *rel.split("/"))
            dst = ctx.abs(rel)
            if not os.path.isfile(src):
                failed.append(rel)
                continue
            par = os.path.dirname(dst)
            try:
                pst = os.lstat(par)
            except OSError:
                failed.append(rel)
                continue
            if par not in touched:
                prow = db.get(parent_of(rel))
                touched[par] = (pst, prow is not None and prow["dmt"] == pst.st_mtime_ns)
            try:
                cur = os.lstat(dst)
                if (cur.st_size, cur.st_mtime_ns) != (row["lsize"], row["lmt"]):
                    failed.append(rel)                                    # changed locally meanwhile: leave it
                    continue
                os.replace(src, dst)
            except OSError:
                failed.append(rel)
                continue
            st = os.lstat(dst)
            db.put(rel=rel, hyd=1, size=st.st_size if not row["gdoc"] else row["size"], mtime=st.st_mtime,
                   **row_local_state(st))
        for par, (pst, was_clean) in touched.items():                       # keep the folder's date and "clean" state
            with contextlib.suppress(OSError):
                os.utime(par, ns=(pst.st_atime_ns, pst.st_mtime_ns))
        db.commit()
    finally:
        bar.stop()
        shutil.rmtree(stage, ignore_errors=True)
    if failed:
        say(f"❌ Could not download {len(failed)} file(s):")
        for f in failed[:10]:
            say(f"   • {f}")
        if rc != 0 and err:
            say("   " + (err.strip().splitlines() or [""])[-1])
        return 1
    return 0


def cmd_clean(ctx, args):
    db = DB(ctx)
    rels = [ctx.rel(p) for p in args.paths] if args.paths else [""]
    freed = n = 0
    for rel in rels:
        rows = [db.get(rel)] if (db.get(rel) is not None and db.get(rel)["kind"] == "f") else db.under(rel) if rel else \
            db.c.execute("SELECT * FROM e WHERE kind='f' AND rel<>''").fetchall()
        for r in rows:
            if r is None or r["kind"] != "f" or not r["hyd"] or r["gdoc"]:
                continue
            p = ctx.abs(r["rel"])
            try:
                st = os.lstat(p)
            except OSError:
                continue
            if (st.st_size, st.st_mtime_ns) != (r["lsize"], r["lmt"]):
                continue                                                    # edited, not pushed yet: never drop it
            par = os.path.dirname(p)
            pst = os.lstat(par)
            make_placeholder(p, r["size"], r["mtime"] or st.st_mtime)
            with contextlib.suppress(OSError):
                os.utime(par, ns=(pst.st_atime_ns, pst.st_mtime_ns))
            st2 = os.lstat(p)
            db.put(rel=r["rel"], hyd=0, **row_local_state(st2))
            freed += st.st_blocks * 512 if hasattr(st, "st_blocks") else st.st_size
            n += 1
    db.commit()
    print(f"{n}\t{freed}")
    return 0


