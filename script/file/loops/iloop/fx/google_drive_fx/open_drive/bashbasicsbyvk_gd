def main(argv=None):
    ap = argparse.ArgumentParser(prog="bashbasicsbyvk_gd")
    sub = ap.add_subparsers(dest="cmd", required=True)
    sub.add_parser("remotes")
    s = sub.add_parser("sync"); s.add_argument("path", nargs="?", default=""); s.add_argument("--force", action="store_true")
    s.add_argument("--recursive", action="store_true")
    sub.add_parser("push")
    h = sub.add_parser("hydrate"); h.add_argument("paths", nargs="+")
    c = sub.add_parser("copy"); c.add_argument("src"); c.add_argument("dst")
    cl = sub.add_parser("clean"); cl.add_argument("paths", nargs="*")
    sub.add_parser("status"); sub.add_parser("about")
    w = sub.add_parser("where"); w.add_argument("path")
    rc_ = sub.add_parser("recover"); rc_.add_argument("path", nargs="?", default=""); rc_.add_argument("--yes", action="store_true")
    ex = sub.add_parser("export"); ex.add_argument("paths", nargs="+"); ex.add_argument("--to", required=True)
    ex.add_argument("--format", default=""); ex.add_argument("--remove-pointers", action="store_true")
    args = ap.parse_args(argv)
    try:
        if args.cmd == "remotes":
            return cmd_remotes(args)
        ctx = Ctx()
        return {"sync": cmd_sync, "push": cmd_push, "hydrate": cmd_hydrate, "copy": cmd_copy, "clean": cmd_clean,
                "status": cmd_status, "about": cmd_about, "where": cmd_where, "export": cmd_export, "recover": cmd_recover}[args.cmd](ctx, args)
    except GdError as e:
        msg = str(e)
        if msg.startswith("__notfound__:"):
            msg = f"'{msg.split(':', 1)[1] or '/'}' was not found in Google Drive"
        say(f"❌ {msg}")
        return 1
    except KeyboardInterrupt:
        say("🚫 Interrupted.")
        return 4


if __name__ == "__main__":
    sys.exit(main())
