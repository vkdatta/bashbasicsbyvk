#!/usr/bin/env python3
"""
bashbasicsbyvk_gd - Google Drive for the file manager, on top of rclone (the ONLY file the drive screens talk to).

How a Drive profile is shown
    Every rclone remote of type "drive" is a profile.  Opening one builds a LOCAL MIRROR of the Drive in
        <profile-dir>/tree/
    Folders are real folders.  Files are zero-cost placeholders (sparse files of the right size and the right
    modified time), so listing, sorting, sizes, dates, filters, find, select rules, c- m- z- uz- ... all work
    on them like on any other folder.  Real content is downloaded ("hydrated") the moment something reads it,
    and everything done to the mirror (create, delete, rename, move, edit, zip ...) is pushed back to Drive.

    bashbasicsbyvk_gd remotes                       TSV  name <TAB> type          (rclone remotes that are Google Drives)
    bashbasicsbyvk_gd sync   REL [--force] [--recursive]      list one Drive folder into the mirror (TTL cached)
    bashbasicsbyvk_gd push                           make Drive match what was done in the mirror
    bashbasicsbyvk_gd hydrate PATH...                download the real content of files / folders (absolute mirror paths)
    bashbasicsbyvk_gd copy   SRC DST                 server-side copy inside the Drive (no download), mirror updated
    bashbasicsbyvk_gd clean  [PATH...]               free the disk: downloaded, unchanged files become placeholders again
    bashbasicsbyvk_gd export PATH... --to DIR [--format F]   the ONLY place a Google file becomes docx/xlsx/pptx/pdf (Google's converter)
    bashbasicsbyvk_gd recover [PATH]                 read-only scan for damaged Office files + where the good copy is (Trash / versions)
    bashbasicsbyvk_gd status | about | where PATH    information

    Google-native files (Docs, Sheets, Slides, Forms, Drawings) are shown as pointers  Foo.gdoc .gsheet .gslides .gform ...
    and are copied / moved / renamed / deleted by their Drive ID.  They are never downloaded as Office files, and nothing
    is ever converted on upload (--drive-import-formats "").

    Environment:  BVK_GD_PROFILE_DIR  BVK_GD_REMOTE  (set by the app)   BVK_GD_RCLONE  BVK_GD_TTL  BVK_GD_TYPES
                  BVK_GD_FLAGS (extra rclone flags)  BVK_GD_CONFIRM_MB  BVK_GD_MAX_DELETE  BVK_GD_PERMANENT
    Extra rclone flags per profile:  <profile-dir>/rclone.flags   (e.g. --drive-shared-with-me)
Exit codes: 0 ok · 1 error · 3 nothing to do/not found · 4 cancelled by the person
"""
import argparse, calendar, contextlib, json, os, re, shlex, shutil, sqlite3, stat, subprocess, sys
import tempfile, threading, time
from concurrent.futures import ThreadPoolExecutor
try:                                   # loadtime: join the app's timeline (no-op unless a screen change is being timed)
    import bashbasicsbyvk_lt as _lt; _lt.install("google drive")
except Exception:
    _lt = None


def _span(name, detail=""):
    return _lt.span(name, detail) if _lt else contextlib.suppress()


RCLONE = os.environ.get("BVK_GD_RCLONE") or shutil.which("rclone") or "rclone"
TTL_DEFAULT = 120
SPARSE_OK = True


class GdError(Exception):
    pass


# ══════════════════════════════════════════════════════════════════════════════════════════════
#  Google-native files (Docs, Sheets, Slides, Forms, Drawings ...)
#    They are NOT Office files.  They have no bytes of their own, so they are never downloaded, never exported and
#    never uploaded as a conversion.  The mirror shows each one as a tiny pointer file (like Google Drive for desktop):
#    Foo.gdoc  Foo.gsheet  Foo.gslides  Foo.gform ...   Copy / move / rename / delete act on the REAL Google file by
#    its Drive ID.  A Word / Excel / PowerPoint file is only made when the person asks for it (gd.export, or a copy
#    out of the Drive), through Google's own converter.
# ══════════════════════════════════════════════════════════════════════════════════════════════
_GA = "application/vnd.google-apps."
NATIVE = {                                    # Drive mime type -> (local extension, open URL, default export format)
    _GA + "document":     ("gdoc",    "https://docs.google.com/document/d/{id}/edit", "docx"),
    _GA + "spreadsheet":  ("gsheet",  "https://docs.google.com/spreadsheets/d/{id}/edit", "xlsx"),
    _GA + "presentation": ("gslides", "https://docs.google.com/presentation/d/{id}/edit", "pptx"),
    _GA + "form":         ("gform",   "https://docs.google.com/forms/d/{id}/edit", None),
    _GA + "drawing":      ("gdraw",   "https://docs.google.com/drawings/d/{id}/edit", "pdf"),
    _GA + "site":         ("gsite",   "https://sites.google.com/d/{id}/edit", None),
    _GA + "map":          ("gmap",    "https://www.google.com/maps/d/edit?mid={id}", None),
    _GA + "script":       ("gscript", "https://script.google.com/d/{id}/edit", "json"),
    _GA + "jam":          ("gjam",    "https://jamboard.google.com/d/{id}/edit", "pdf"),
}
GENERIC_NATIVE = ("gfile", "https://drive.google.com/open?id={id}", None)    # a Google file whose kind rclone did not tell
NATIVE_EXTS = tuple(v[0] for v in NATIVE.values()) + (GENERIC_NATIVE[0],)
EXPORT_FORMATS = {                             # what Google itself can convert each kind into
    "gdoc": ("docx", "odt", "pdf", "txt", "html", "rtf", "epub", "md", "zip"),
    "gsheet": ("xlsx", "ods", "pdf", "csv", "tsv", "html", "zip"),
    "gslides": ("pptx", "odp", "pdf", "txt"),
    "gdraw": ("pdf", "svg", "png", "jpg"),
    "gscript": ("json",), "gjam": ("pdf",),
}
DEFAULT_EXPORT = {v[0]: v[2] for v in NATIVE.values() if v[2]}
POINTER_TAG = "bvk-google-native-pointer"
_NO_KIND = (_GA + "folder", _GA + "shortcut")


def native_ext(name):
    for e in NATIVE_EXTS:
        if name.endswith("." + e):
            return e
    return ""


def native_meta(ctype):
    return NATIVE.get(ctype, GENERIC_NATIVE)


def pointer_bytes(ext, did, remote):
    url = next((v[1] for v in list(NATIVE.values()) + [GENERIC_NATIVE] if v[0] == ext), GENERIC_NATIVE[1]).format(id=did)
    return (json.dumps({"url": url, "doc_id": did, "remote": remote, "kind": ext, "tag": POINTER_TAG},
                       sort_keys=True, indent=1) + "\n").encode()


def read_pointer(path):
    """the pointer a mirror file holds -> dict, or None for anything that is not one of ours"""
    try:
        if os.path.getsize(path) > 4096:
            return None
        with open(path, "rb") as fh:
            d = json.loads(fh.read().decode("utf-8"))
        return d if isinstance(d, dict) and d.get("tag") == POINTER_TAG and d.get("doc_id") else None
    except (OSError, ValueError):
        return None


def drive_name(local_name):
    """name Google Drive gives a native file: the pointer extension is ours, Drive has none"""
    e = native_ext(local_name)
    return local_name[: -(len(e) + 1)] if e else local_name


# ══════════════════════════════════════════════════════════════════════════════════════════════
#  loading bar  (same look as the smartload bar:  [░░░████░░░░░] message  3s; off when BVK_GD_BAR=0, which the app sets while smartload runs)
# ══════════════════════════════════════════════════════════════════════════════════════════════
class Bar:
    def __init__(self, msg):
        self.msg = msg
        self.t0 = time.monotonic()
        self.stop_ev = threading.Event()
        self.pause_ev = threading.Event()
        self.th = None
        self.out = None
        self.lock = threading.Lock()
        if os.environ.get("BVK_GD_BAR") == "0":
            return
        for cand in (os.environ.get("BVK_GD_BAR_TTY") or "/dev/tty", ):
            try:
                self.out = open(cand, "w")
                break
            except OSError:
                self.out = None
        if self.out is None and sys.stderr.isatty():
            self.out = sys.stderr

    def cols(self):
        try:
            return os.get_terminal_size(self.out.fileno()).columns
        except Exception:
            try:
                return shutil.get_terminal_size((60, 20)).columns
            except Exception:
                return 60

    def _loop(self):
        if self.stop_ev.wait(0.15):             # short grace period: instant work never flashes a bar
            return
        cols = self.cols()
        room = max(12, cols - 14)
        W = max(8, min(22, room - 4))
        BW = max(2, min(5, W // 3))
        maxmsg = max(0, cols - W - 14)
        msg = self.msg
        if len(msg) > maxmsg:
            msg = msg[: max(0, maxmsg - 1)] + "…"
        track, blk = "░" * W, "█" * BW
        pos, d = 0, 1
        while not self.stop_ev.is_set():
            if not self.pause_ev.is_set():
                el = int(time.monotonic() - self.t0)
                t = f"  {el}s" if el >= 2 else ""
                line = "\033[36m[" + track[:pos] + blk + track[: W - pos - BW] + "]\033[0m " + msg + t
                with self.lock:
                    try:
                        self.out.write("\r\033[2K" + line)
                        self.out.flush()
                    except Exception:
                        return
                pos += d
                if pos >= W - BW:
                    pos, d = W - BW, -1
                elif pos <= 0:
                    pos, d = 0, 1
            self.stop_ev.wait(0.1)

    def start(self):
        if self.out is None:
            return self
        try:
            self.out.write("\033[?25l")
            self.out.flush()
        except Exception:
            self.out = None
            return self
        self.th = threading.Thread(target=self._loop, daemon=True)
        self.th.start()
        return self

    def _clear(self, cursor=True):
        if self.out is None:
            return
        with self.lock:
            try:
                self.out.write("\r\033[2K" + ("\033[?25h" if cursor else ""))
                self.out.flush()
            except Exception:
                pass

    def stop(self):
        self.stop_ev.set()
        if self.th:
            self.th.join(1)
        self._clear()
        if self.out not in (None, sys.stderr):
            try:
                self.out.close()
            except Exception:
                pass
        self.out = None

    @contextlib.contextmanager
    def paused(self):
        """Hide the bar while something else (rclone --progress, a question) draws on the terminal."""
        self.pause_ev.set()
        self._clear(cursor=True)
        try:
            yield
        finally:
            self.pause_ev.clear()
            if self.out is not None:
                try:
                    self.out.write("\033[?25l")
                    self.out.flush()
                except Exception:
                    pass

    def __enter__(self):
        return self.start()

    def __exit__(self, *a):
        self.stop()


class NoBar:
    msg = ""

    @contextlib.contextmanager
    def paused(self):
        yield


def say(msg):
    print(msg, file=sys.stderr, flush=True)


def ask_yes(prompt):
    """y/N on the terminal (works while stdin/stdout are pipes).  No terminal -> no."""
    try:
        with open("/dev/tty", "r+") as tty:
            tty.write(prompt + " (y/N): ")
            tty.flush()
            return tty.readline().strip().lower() in ("y", "yes")
    except OSError:
        return False


# ══════════════════════════════════════════════════════════════════════════════════════════════
#  helpers
# ══════════════════════════════════════════════════════════════════════════════════════════════
_TS = re.compile(r"^(\d{4})-(\d\d)-(\d\d)[T ](\d\d):(\d\d):(\d\d)(?:\.(\d+))?(Z|[+-]\d\d:?\d\d)?$")


def parse_ts(s):
    m = _TS.match(s or "")
    if not m:
        return 0.0
    y, mo, d, h, mi, se, frac, tz = m.groups()
    t = calendar.timegm((int(y), int(mo), int(d), int(h), int(mi), int(se)))
    if frac:
        t += float("0." + frac)
    if tz and tz != "Z":
        sign = 1 if tz[0] == "+" else -1
        hh, mm = int(tz[1:3]), int(tz[-2:])
        t -= sign * (hh * 3600 + mm * 60)
    return t


def join(rel, name):
    return f"{rel}/{name}" if rel else name


def parent_of(rel):
    return rel.rpartition("/")[0]


def name_of(rel):
    return rel.rpartition("/")[2]


def bad_name(n):
    return (not n) or n in (".", "..") or "/" in n or "\0" in n


def fmt_size(b):
    b = float(b)
    for u in ("B", "KB", "MB", "GB", "TB"):
        if b < 1024 or u == "TB":
            return f"{int(b)} {u}" if u == "B" else f"{b:.1f} {u}"
        b /= 1024


class Ctx:
    def __init__(self):
        pd = os.environ.get("BVK_GD_PROFILE_DIR")
        self.remote = os.environ.get("BVK_GD_REMOTE")
        if not pd or not self.remote:
            raise GdError("BVK_GD_PROFILE_DIR / BVK_GD_REMOTE are not set (the app sets them when a Drive is opened).")
        self.pdir = os.path.abspath(pd)
        self.tree = os.path.join(self.pdir, "tree")
        self.tmp = os.path.join(self.pdir, "tmp")
        os.makedirs(self.tree, exist_ok=True)
        os.makedirs(self.tmp, exist_ok=True)
        self.ttl = int(os.environ.get("BVK_GD_TTL") or TTL_DEFAULT)
        self.flags = []
        ff = os.path.join(self.pdir, "rclone.flags")
        try:
            with open(ff) as fh:
                for line in fh:
                    line = line.split("#", 1)[0].strip()
                    if line:
                        self.flags += shlex.split(line)
        except OSError:
            pass
        self.flags += shlex.split(os.environ.get("BVK_GD_FLAGS", ""))
        self.bar = NoBar()

    def abs(self, rel):
        return os.path.join(self.tree, *rel.split("/")) if rel else self.tree

    def rel(self, path):
        p = os.path.abspath(path)
        if p == self.tree:
            return ""
        pre = self.tree + os.sep
        if not p.startswith(pre):
            raise GdError(f"not inside this Drive: {path}")
        return p[len(pre):].replace(os.sep, "/")

    def rpath(self, rel):
        return f"{self.remote}:{rel}"


def rclone(ctx, args, check=True, passthrough=False, quiet_ok=(), export=None):
    # --drive-export-formats url : Google files are listed as links, so rclone never fabricates .docx/.xlsx/.pptx names
    #                              (export=<fmt> is passed ONLY by an explicit export, nothing else)
    # --drive-import-formats ""  : files are uploaded exactly as they are, never converted into Google Docs/Sheets/Slides
    cmd = [RCLONE, "--ask-password=false", *ctx.flags, "--drive-export-formats", export or "url",
           "--drive-import-formats", "", *args]
    try:
        with _span("rclone " + str(args[0] if args else "")):      # rclone does not report DNS / TLS / first byte: loadtime probes the host
            if passthrough:
                p = subprocess.run(cmd, stdin=subprocess.DEVNULL)
                out, err = "", ""
            else:
                p = subprocess.run(cmd, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True,
                                   errors="replace")
                out, err = p.stdout, p.stderr
    except FileNotFoundError:
        raise GdError("rclone is not installed (see README → Rclone).")
    if check and p.returncode != 0 and p.returncode not in quiet_ok:
        tail = [l for l in (err or "").strip().splitlines() if l.strip()][-3:]
        raise GdError(f"rclone {args[0]} failed (exit {p.returncode}): " + " | ".join(tail))
    return p.returncode, out, err


# ══════════════════════════════════════════════════════════════════════════════════════════════
#  manifest  (what the mirror knew about Drive the last time we looked)
# ══════════════════════════════════════════════════════════════════════════════════════════════
class DB:
    def __init__(self, ctx):
        self.c = sqlite3.connect(os.path.join(ctx.pdir, "manifest.db"), timeout=30)
        self.c.row_factory = sqlite3.Row
        self.c.executescript("""
            CREATE TABLE IF NOT EXISTS e(
              rel TEXT PRIMARY KEY, parent TEXT NOT NULL, name TEXT NOT NULL, kind TEXT NOT NULL,
              size INTEGER DEFAULT 0, mtime REAL DEFAULT 0, hyd INTEGER DEFAULT 0, gdoc INTEGER DEFAULT 0,
              lsize INTEGER DEFAULT 0, lmt INTEGER DEFAULT 0, ino INTEGER DEFAULT 0, dev INTEGER DEFAULT 0,
              listed REAL DEFAULT 0, dmt INTEGER DEFAULT 0, did TEXT DEFAULT '');
            CREATE INDEX IF NOT EXISTS e_parent ON e(parent);
            CREATE INDEX IF NOT EXISTS e_hyd ON e(hyd);
        """)
        try:                                           # older manifests: add the Drive-ID column
            self.c.execute("ALTER TABLE e ADD COLUMN did TEXT DEFAULT ''")
        except sqlite3.OperationalError:
            pass
        if self.get("") is None:
            st = os.lstat(ctx.tree)
            self.put(rel="", parent="", name="", kind="d", ino=st.st_ino, dev=st.st_dev, dmt=-1)
        self.c.commit()

    COLS = ("rel", "parent", "name", "kind", "size", "mtime", "hyd", "gdoc", "lsize", "lmt", "ino", "dev", "listed", "dmt", "did")

    def get(self, rel):
        return self.c.execute("SELECT * FROM e WHERE rel=?", (rel,)).fetchone()

    def children(self, rel):
        return self.c.execute("SELECT * FROM e WHERE parent=? AND rel<>''", (rel,)).fetchall()

    def dirs(self):
        return self.c.execute("SELECT * FROM e WHERE kind='d' ORDER BY rel").fetchall()

    def put(self, **kw):
        """insert or update only the given columns"""
        rel = kw["rel"]
        cur = self.get(rel)
        if cur is None:
            row = {c: 0 for c in self.COLS}
            row.update(parent=parent_of(rel), name=name_of(rel), kind="f", rel=rel, did="")
            row.update(kw)
            self.c.execute("INSERT INTO e(%s) VALUES(%s)" % (",".join(self.COLS), ",".join("?" * len(self.COLS))),
                           [row[c] for c in self.COLS])
        else:
            kw = {k: v for k, v in kw.items() if k != "rel"}
            if kw:
                self.c.execute("UPDATE e SET %s WHERE rel=?" % ",".join(f"{k}=?" for k in kw), [*kw.values(), rel])

    def under(self, rel):
        pre = rel + "/"
        return self.c.execute("SELECT * FROM e WHERE substr(rel,1,?)=?", (len(pre), pre)).fetchall()

    def delete_tree(self, rel):
        pre = rel + "/"
        self.c.execute("DELETE FROM e WHERE rel=? OR substr(rel,1,?)=?", (rel, len(pre), pre))

    def rename_tree(self, old, new):
        rows = self.c.execute("SELECT rel FROM e WHERE rel=? OR substr(rel,1,?)=?", (old, len(old) + 1, old + "/")).fetchall()
        for r in rows:
            o = r["rel"]
            n = new + o[len(old):]
            self.c.execute("DELETE FROM e WHERE rel=?", (n,))
            self.c.execute("UPDATE e SET rel=?, parent=?, name=? WHERE rel=?", (n, parent_of(n), name_of(n), o))

    def commit(self):
        self.c.commit()


# ══════════════════════════════════════════════════════════════════════════════════════════════
#  mirror <-> manifest primitives
# ══════════════════════════════════════════════════════════════════════════════════════════════
def make_placeholder(path, size, mtime):
    """a file of the right size that takes (almost) no disk: sparse"""
    global SPARSE_OK
    with open(path, "wb") as f:
        try:
            f.truncate(size)
        except OSError:
            SPARSE_OK = False
    os.utime(path, (mtime, mtime))


def lst(path):
    st = os.lstat(path)
    return st


def row_local_state(st):
    return dict(lsize=st.st_size, lmt=st.st_mtime_ns, ino=st.st_ino, dev=st.st_dev)


def is_placeholder_copy(st):
    """regular file that claims a size but owns no disk blocks -> a copy of a placeholder, not real content"""
    return st.st_size > 0 and getattr(st, "st_blocks", 1) == 0


def list_remote(ctx, rel, recursive=False, did=""):
    """List one Drive folder.  With the folder's Drive ID this is ONE API call at any depth (rclone otherwise
    resolves a/b/c/... one level at a time, every call, because its folder cache dies with the process)."""
    extra = ["--metadata"] + (["-R"] if recursive else [])        # Metadata.content-type = the real Drive type
    rc = None
    if did:
        rc, out, err = rclone(ctx, ["lsjson", f"{ctx.remote}:", "--drive-root-folder-id", did, *extra], check=False)
        if rc != 0:
            did = ""                                   # stale / inaccessible ID -> fall back to the path walk
    if not did:
        rc, out, err = rclone(ctx, ["lsjson", ctx.rpath(rel), *extra], check=False)
    if rc == 3:                                    # directory not found
        raise GdError(f"__notfound__:{rel}")
    if rc != 0:
        tail = [l for l in (err or "").strip().splitlines() if l.strip()][-3:]
        raise GdError(f"could not list '{rel or '/'}' (rclone exit {rc}): " + " | ".join(tail))
    try:
        data = json.loads(out or "[]")
    except ValueError:
        raise GdError("rclone returned something that is not JSON.")
    res = []
    for e in data:
        p = e.get("Path") or e.get("Name") or ""
        nm = e.get("Name") or name_of(p)
        ent = dict(path=p, name=nm, dir=bool(e.get("IsDir")), id=e.get("ID") or "",
                   size=int(e.get("Size", 0) or 0), mtime=parse_ts(e.get("ModTime", "")), native="")
        md = e.get("Metadata") or {}
        ctype = md.get("content-type") or md.get("mime-type") or ""
        if not ent["dir"] and ctype not in _NO_KIND and (ctype.startswith(_GA) or (not ctype and ent["size"] < 0)):
            ext = native_meta(ctype)[0]
            base = nm[:-4] if nm.endswith(".url") else nm                # rclone shows a Google file as  <name>.url
            ent.update(native=ext, name=base + "." + ext, path=join(parent_of(p), base + "." + ext), size=0)
        res.append(ent)
    return res


def prune_known(ctx, db, rel):
    """Drive no longer has <rel>: remove what the mirror holds for it, unless the person changed it locally."""
    row = db.get(rel)
    p = ctx.abs(rel)
    if row is None:
        return
    if row["kind"] == "f":
        try:
            st = os.lstat(p)
        except OSError:
            db.delete_tree(rel)
            return
        if (st.st_size, st.st_mtime_ns) == (row["lsize"], row["lmt"]):
            try:
                os.unlink(p)
            except OSError:
                pass
        db.delete_tree(rel)                        # a locally changed file survives and is pushed as new
        return
    for r in sorted(db.under(rel), key=lambda r: -len(r["rel"])):
        q = ctx.abs(r["rel"])
        try:
            st = os.lstat(q)
        except OSError:
            continue
        if r["kind"] == "f" and (st.st_size, st.st_mtime_ns) == (r["lsize"], r["lmt"]):
            with contextlib.suppress(OSError):
                os.unlink(q)
        elif r["kind"] == "d":
            with contextlib.suppress(OSError):
                os.rmdir(q)
    with contextlib.suppress(OSError):
        os.rmdir(p)
    db.delete_tree(rel)


def write_pointer(path, data, mtime):
    tmp = path + ".bvk-tmp"
    with open(tmp, "wb") as fh:
        fh.write(data)
    os.replace(tmp, path)
    os.utime(path, (mtime, mtime))


def reconcile_native(ctx, db, rel, crel, ent, row, p, exists, stats):
    """a Google-native file: the mirror holds a small pointer, never exported content"""
    data = pointer_bytes(ent["native"], ent["id"], ctx.remote)
    mt = ent["mtime"] or time.time()
    if exists and not stat.S_ISREG(os.lstat(p).st_mode):
        stats["skipped"] += 1
        return
    if not exists:
        if row is not None:
            db.delete_tree(crel)
        write_pointer(p, data, mt)
        db.put(rel=crel, kind="f", size=len(data), mtime=mt, hyd=1, gdoc=1, did=ent["id"], **row_local_state(os.lstat(p)))
        stats["new"] += 1
        return
    st = os.lstat(p)
    if row is None or row["kind"] != "f":
        stats["skipped"] += 1                              # a local file with this name that Drive does not know yet
        return
    local_modified = (st.st_size, st.st_mtime_ns) != (row["lsize"], row["lmt"])
    if local_modified and not row["gdoc"]:
        return                                             # a real file the person made: pushed later
    cur = read_pointer(p)
    if cur is None or cur.get("doc_id") != ent["id"] or abs(st.st_mtime - mt) > 1.5:
        write_pointer(p, data, mt)                         # also repairs a pointer somebody edited
        stats["changed"] += 1
    db.put(rel=crel, size=len(data), mtime=mt, hyd=1, gdoc=1, did=ent["id"], **row_local_state(os.lstat(p)))
    db.put(rel=crel, did=ent["id"])


def reconcile_dir(ctx, db, rel, remote, now, stats):
    """Make folder <rel> of the mirror show exactly what Drive lists (remote = list of entries)."""
    d_abs = ctx.abs(rel)
    os.makedirs(d_abs, exist_ok=True)
    rows = {r["name"]: r for r in db.children(rel)}
    try:
        local = {e.name for e in os.scandir(d_abs)}
    except OSError:
        local = set()
    seen = set()
    for ent in remote:
        name = ent["name"]
        if bad_name(name):
            stats["skipped"] += 1
            continue
        if name in seen:
            stats["dups"] += 1
            continue
        seen.add(name)
        crel = join(rel, name)
        row = rows.get(name)
        p = os.path.join(d_abs, name)
        exists = name in local
        if ent["dir"]:
            if exists and not stat.S_ISDIR(os.lstat(p).st_mode):
                stats["skipped"] += 1
                continue
            if not exists:
                os.mkdir(p)
                os.utime(p, (ent["mtime"] or time.time(),) * 2)
                stats["new"] += 1
            st = os.lstat(p)
            if row is None or row["kind"] != "d":
                if row is not None:
                    db.delete_tree(crel)
                db.put(rel=crel, kind="d", mtime=ent["mtime"], ino=st.st_ino, dev=st.st_dev, dmt=st.st_mtime_ns, listed=0, did=ent.get("id", ""))
            else:
                db.put(rel=crel, mtime=ent["mtime"], ino=st.st_ino, dev=st.st_dev, did=ent.get("id", "") or row["did"])
            continue
        # file
        if ent.get("native"):
            reconcile_native(ctx, db, rel, crel, ent, row, p, exists, stats)
            continue
        size = max(ent["size"], 0)
        gdoc = 0
        if exists and not stat.S_ISREG(os.lstat(p).st_mode):
            stats["skipped"] += 1
            continue
        if not exists:
            if row is not None:
                db.delete_tree(crel)
            make_placeholder(p, size, ent["mtime"] or time.time())
            st = os.lstat(p)
            db.put(rel=crel, kind="f", size=size, mtime=ent["mtime"], hyd=0, gdoc=gdoc, **row_local_state(st))
            stats["new"] += 1
            continue
        st = os.lstat(p)
        if row is None or row["kind"] != "f":
            # a local entry with the same name that Drive does not know yet: the local one wins (it is pushed later)
            stats["skipped"] += 1
            continue
        local_modified = (st.st_size, st.st_mtime_ns) != (row["lsize"], row["lmt"])
        remote_changed = (size != row["size"] and not gdoc) or abs((ent["mtime"] or 0) - (row["mtime"] or 0)) > 1.5
        if local_modified:
            db.put(rel=crel, gdoc=gdoc)
            continue
        if remote_changed or (not row["hyd"] and size != st.st_size):
            make_placeholder(p, size, ent["mtime"] or time.time())     # stale download -> placeholder again
            st = os.lstat(p)
            db.put(rel=crel, size=size, mtime=ent["mtime"], hyd=0, gdoc=gdoc, **row_local_state(st))
            stats["changed"] += 1
    for name, row in rows.items():
        if name in seen:
            continue
        prune_known(ctx, db, row["rel"])
        stats["gone"] += 1
    # the folder shows the modified time Drive has for it; remember what the folder looks like now
    me = db.get(rel)
    if rel and me is not None and me["mtime"]:
        with contextlib.suppress(OSError):
            os.utime(d_abs, (me["mtime"], me["mtime"]))
    st = os.lstat(d_abs)
    db.put(rel=rel, listed=now, dmt=st.st_mtime_ns, ino=st.st_ino, dev=st.st_dev)


def sync_dir(ctx, db, rel, force=False, recursive=False):
    now = time.time()
    row = db.get(rel)
    if row is None and rel:
        # unknown folder (never listed through its parent): list the parent first
        sync_dir(ctx, db, parent_of(rel), force=False)
        row = db.get(rel)
        if row is None:
            raise GdError(f"__notfound__:{rel}")
    if row is not None and row["kind"] != "d":
        raise GdError(f"not a folder: {rel}")
    if not force and not recursive and row is not None and row["listed"] and now - row["listed"] < ctx.ttl:
        return {"cached": True}
    stats = dict(new=0, changed=0, gone=0, dups=0, skipped=0, cached=False)
    try:
        if not recursive:
            reconcile_dir(ctx, db, rel, list_remote(ctx, rel, did=(row["did"] if row is not None else "")), now, stats)
        else:
            flat = list_remote(ctx, rel, recursive=True, did=(row["did"] if row is not None else ""))
            by_dir = {rel: []}
            for e in flat:
                full = join(rel, e["path"])
                by_dir.setdefault(parent_of(full), []).append(e)
                if e["dir"]:
                    by_dir.setdefault(full, [])
            for d in sorted(by_dir, key=lambda x: x.count("/")):       # parents first
                reconcile_dir(ctx, db, d, by_dir[d], now, stats)
    except GdError as ex:
        if str(ex).startswith("__notfound__:"):
            if not rel:
                raise GdError(f"the top of '{ctx.remote}:' could not be listed — is the remote reachable and logged in? "
                              f"(try: rclone lsd {ctx.remote}:)")
            prune_known(ctx, db, rel)
            db.commit()
            raise GdError(f"'{rel}' no longer exists in Google Drive")
        raise
    db.commit()
    return stats


