#  push: make Drive match what was done to the mirror
# ══════════════════════════════════════════════════════════════════════════════════════════════
class New:
    def __init__(self, rel, st, isdir):
        self.rel, self.st, self.isdir = rel, st, isdir


def scan_changes(ctx, db):
    news, gone, modified, scanned = [], [], [], []
    for drow in db.dirs():
        rel = drow["rel"]
        p = ctx.abs(rel)
        try:
            st = os.lstat(p)
        except OSError:
            continue
        if not stat.S_ISDIR(st.st_mode) or st.st_mtime_ns == drow["dmt"]:
            continue
        try:
            ents = {e.name: e for e in os.scandir(p)}
        except OSError:
            continue
        scanned.append(rel)
        rows = {r["name"]: r for r in db.children(rel)}
        for name, e in ents.items():
            crel = join(rel, name)
            try:
                est = e.stat(follow_symlinks=False)
            except OSError:
                continue
            isdir, isfile = stat.S_ISDIR(est.st_mode), stat.S_ISREG(est.st_mode)
            if not (isdir or isfile):
                continue
            r = rows.get(name)
            if r is None:
                news.append(New(crel, est, isdir))
            elif (r["kind"] == "d") != isdir:
                gone.append(r)
                news.append(New(crel, est, isdir))
            elif isfile and (est.st_size, est.st_mtime_ns) != (r["lsize"], r["lmt"]):
                modified.append((r, est))
        for name, r in rows.items():
            e = ents.get(name)
            if e is None:
                gone.append(r)
            else:
                try:
                    m = os.lstat(e.path).st_mode
                except OSError:
                    continue
                if not (stat.S_ISDIR(m) or stat.S_ISREG(m)):
                    gone.append(r)
    # edited files in folders that did not change at all (an editor rewrote the file in place)
    seen = {r["rel"] for r, _ in modified}
    for r in db.c.execute("SELECT * FROM e WHERE kind='f' AND hyd=1").fetchall():
        if r["rel"] in seen or parent_of(r["rel"]) in scanned:
            continue
        try:
            est = os.lstat(ctx.abs(r["rel"]))
        except OSError:
            continue
        if stat.S_ISREG(est.st_mode) and (est.st_size, est.st_mtime_ns) != (r["lsize"], r["lmt"]):
            modified.append((r, est))
    return news, gone, modified, scanned


def walk_new(ctx, item):
    """a new folder: everything inside it is new as well"""
    out = [item]
    if not item.isdir:
        return out
    for root, dirs, files in os.walk(ctx.abs(item.rel), followlinks=False):
        rrel = ctx.rel(root)
        for n in dirs:
            try:
                st = os.lstat(os.path.join(root, n))
            except OSError:
                continue
            if stat.S_ISDIR(st.st_mode):
                out.append(New(join(rrel, n), st, True))
        for n in files:
            try:
                st = os.lstat(os.path.join(root, n))
            except OSError:
                continue
            if stat.S_ISREG(st.st_mode):
                out.append(New(join(rrel, n), st, False))
    return out


def rclone_rel(row):
    """the path rclone knows a file by: a Google file is  <name>.url  for rclone, <name>.gdoc etc. in the mirror"""
    if row["gdoc"] and native_ext(row["rel"]):
        return join(parent_of(row["rel"]), drive_name(name_of(row["rel"])) + ".url")
    return row["rel"]


def backend_id(ctx, verb, did, dest):
    rc, out, err = rclone(ctx, ["backend", verb, f"{ctx.remote}:", did, dest], check=False)
    if rc != 0:
        tail = [l for l in (err or "").strip().splitlines() if l.strip()][-2:]
        raise GdError(f"{verb} failed (rclone exit {rc}): " + " | ".join(tail))


def copy_id(ctx, did, dest_rel):
    backend_id(ctx, "copyid", did, dest_rel)


def move_one(ctx, r, n):
    """move / rename inside the Drive.  A Google file moves by its ID: no export, no re-upload, nothing converted."""
    if r["kind"] == "f" and r["gdoc"] and r["did"]:
        backend_id(ctx, "moveid", r["did"], join(parent_of(n.rel), drive_name(name_of(n.rel))))
    else:
        rclone(ctx, ["moveto", ctx.rpath(rclone_rel(r) if r["kind"] == "f" else r["rel"]), ctx.rpath(n.rel)])


def run_levels(items, depth_of, fn, workers=4):
    """run fn(item) in parallel, shallow items before deeper ones; returns [(item, error-or-None)]"""
    res = []
    for d in sorted({depth_of(i) for i in items}):
        level = [i for i in items if depth_of(i) == d]
        with ThreadPoolExecutor(max_workers=workers) as ex:
            futs = [(i, ex.submit(fn, i)) for i in level]
            for i, f in futs:
                try:
                    f.result()
                    res.append((i, None))
                except GdError as e:
                    res.append((i, str(e)))
    return res


def cmd_push(ctx, args=None):
    db = DB(ctx)
    if not os.path.isdir(ctx.tree):
        raise GdError("the Drive mirror folder is missing — nothing was pushed.")
    total = dict(up=0, mv=0, rm=0, mk=0, err=0, skipped=0)
    bar = Bar("Syncing changes to Google Drive").start()
    ctx.bar = bar
    try:
        for _round in range(3):
            news, gone, modified, scanned = scan_changes(ctx, db)
            if not (news or gone or modified):
                for rel in scanned:
                    with contextlib.suppress(OSError):
                        db.put(rel=rel, dmt=os.lstat(ctx.abs(rel)).st_mtime_ns)
                db.commit()
                break
            did = push_round(ctx, db, bar, news, gone, modified, scanned, total)
            db.commit()
            if not did:
                break
    finally:
        bar.stop()
    bits = []
    if total["mk"]:
        bits.append(f"📁 {total['mk']} folder(s) created")
    if total["up"]:
        bits.append(f"🔼  {total['up']} uploaded")
    if total["mv"]:
        bits.append(f"⇄ {total['mv']} moved/renamed")
    if total["rm"]:
        bits.append(f"🗑️  {total['rm']} removed" + ("" if os.environ.get("BVK_GD_PERMANENT") == "1" else " (Drive trash)"))
    if total["skipped"]:
        bits.append(f"🔴  {total['skipped']} placeholder copy(ies) not uploaded")
    if bits:
        say("☁️  Drive synced: " + " · ".join(bits))
    if total["err"]:
        say(f"❌ {total['err']} change(s) could not be pushed — they will be retried next time.")
        return 1
    return 0


def push_round(ctx, db, bar, news, gone, modified, scanned, total):
    # ── 1. moves: a vanished entry and a new entry that are the same inode ────────────────────────────
    gone_by_ino = {}
    for r in gone:
        gone_by_ino.setdefault((r["dev"], r["ino"], r["kind"]), []).append(r)
    moves, rest_new = [], []
    claimed = set()
    for n in news:
        key = (n.st.st_dev, n.st.st_ino, "d" if n.isdir else "f")
        cands = [r for r in gone_by_ino.get(key, []) if r["rel"] not in claimed and r["ino"]]
        if not n.isdir:
            # a file only counts as "moved" when it is still exactly what the mirror recorded; a recycled inode
            # (rm a; touch b) or a moved-and-edited file is a delete + a new upload instead
            cands = [r for r in cands if (n.st.st_size, n.st.st_mtime_ns) == (r["lsize"], r["lmt"])]
        if cands:
            r = cands[0]
            claimed.add(r["rel"])
            moves.append((r, n))
        else:
            rest_new.append(n)
    # ROOT CAUSE of the Organise disaster: files moved INTO A NEW FOLDER were never matched as moves (only the new
    # folder itself was looked at), so every one became "delete the old + upload a new" and the old one went to Trash.
    # Look inside the new folders too, and match those files by inode exactly like the others.
    expanded = []
    for n in rest_new:
        expanded += walk_new(ctx, n)
    still_new = []
    for n in expanded:
        if n.isdir:
            still_new.append(n)
            continue
        key = (n.st.st_dev, n.st.st_ino, "f")
        cands = [r for r in gone_by_ino.get(key, []) if r["rel"] not in claimed and r["ino"]
                 and (n.st.st_size, n.st.st_mtime_ns) == (r["lsize"], r["lmt"])]
        if cands:
            claimed.add(cands[0]["rel"])
            moves.append((cands[0], n))
        else:
            still_new.append(n)
    expanded = still_new
    gone = [r for r in gone if r["rel"] not in claimed]
    # ── 2. folders and files that are really new ─────────────────────────────────────────────────────
    new_dirs = [n for n in expanded if n.isdir]
    new_files = [n for n in expanded if not n.isdir]
    uploads, skipped, ptr_copies = [], 0, []
    known_native = {r["did"]: r for r in db.c.execute("SELECT * FROM e WHERE gdoc=1 AND did<>''").fetchall()}
    for n in new_files:
        ptr = read_pointer(ctx.abs(n.rel)) if native_ext(n.rel) else None
        if ptr and ptr["doc_id"] in known_native:          # cp of a Foo.gdoc: copy the Google file itself, by ID
            ptr_copies.append((n, ptr["doc_id"]))
            continue
        if is_placeholder_copy(n.st):
            skipped += 1
            say(f"🔴  Not uploaded (looks like a copy of a not-downloaded file): {n.rel}")
            continue
        uploads.append((n.rel, n.st, None))
    for r, est in modified:
        if r["gdoc"]:
            say(f"🔴  '{r['rel']}' is a Google file shown as a pointer; its content lives in Google and was left untouched. "
                f"Open it in Google, or use gd.export to get a Word/Excel/PowerPoint copy.")
            with contextlib.suppress(OSError):
                d = pointer_bytes(native_ext(r["rel"]) or GENERIC_NATIVE[0], r["did"], ctx.remote)
                write_pointer(ctx.abs(r["rel"]), d, r["mtime"] or time.time())
                db.put(rel=r["rel"], size=len(d), **row_local_state(os.lstat(ctx.abs(r["rel"]))))
            continue
        if is_placeholder_copy(est):
            skipped += 1
            say(f"🔴  Not uploaded (looks like a not-downloaded placeholder): {r['rel']}")
            continue
        uploads.append((r["rel"], est, r))
    total["skipped"] += skipped
    # SAFETY: an item that vanished from the mirror but whose "new" twin was refused as a placeholder copy is NOT removed
    # from Drive (that was the second way files were lost: trashed, and never re-uploaded)
    if skipped:
        gone = [r for r in gone if not (r["kind"] == "f" and any(
            u.rel != r["rel"] and name_of(u.rel) == name_of(r["rel"]) for u in new_files if is_placeholder_copy(u.st)))]
    # ── 3. safety net before removing things ─────────────────────────────────────────────────────────
    max_del = int(os.environ.get("BVK_GD_MAX_DELETE", "100"))
    n_native_gone = sum(1 for r in gone if r["kind"] == "f" and r["gdoc"])
    if n_native_gone and os.environ.get("BVK_GD_CONFIRM_NATIVE_DELETE", "1") == "1":
        with bar.paused():
            ok_n = ask_yes(f"🔴  {n_native_gone} Google Docs/Sheets/Slides/Forms will be moved to Google Drive Trash. Continue")
        if not ok_n:
            say("🚫 Nothing removed from Drive — the folder is listed again from Google Drive.")
            for r in gone:
                par = db.get(parent_of(r["rel"]))
                db.delete_tree(r["rel"])
                if par is not None:
                    db.put(rel=par["rel"], listed=0)
            gone = []
    if len(gone) > max_del:
        with bar.paused():
            ok = ask_yes(f"🔴  {len(gone)} items are missing from the Drive mirror. Remove them from Google Drive too")
        if not ok:
            say("🚫 Nothing removed from Drive — the folder is listed again from Google Drive.")
            for r in gone:
                par = db.get(parent_of(r["rel"]))
                db.delete_tree(r["rel"])
                if par is not None:
                    db.put(rel=par["rel"], listed=0)      # next visit re-creates the placeholders
            gone = []
    failed_dirs = set()
    did = False

    def fail(rel, why):
        total["err"] += 1
        failed_dirs.add(parent_of(rel))
        say(f"❌ {rel}: {why}")

    # ── 4. do it: mkdir -> move -> upload -> delete ───────────────────────────────────────────────────
    ok_dirs = []
    for it, err in run_levels(new_dirs, lambda n: n.rel.count("/"),
                              lambda n: rclone(ctx, ["mkdir", ctx.rpath(n.rel)])):
        if err:
            fail(it.rel, err)
        else:
            ok_dirs.append(it)
            total["mk"] += 1
            did = True
            db.put(rel=it.rel, kind="d", mtime=it.st.st_mtime, ino=it.st.st_ino, dev=it.st.st_dev,
                   dmt=it.st.st_mtime_ns, listed=time.time())
    for it, err in run_levels(moves, lambda m: m[1].rel.count("/"), lambda m: move_one(ctx, m[0], m[1])):
        r, n = it
        if err:
            fail(n.rel, err)
            continue
        total["mv"] += 1
        did = True
        if r["kind"] == "d":
            db.rename_tree(r["rel"], n.rel)
            db.put(rel=n.rel, ino=n.st.st_ino, dev=n.st.st_dev)           # dmt stays: inner changes are re-scanned
            scanned.append(parent_of(n.rel))
        else:
            db.delete_tree(n.rel)
            db.rename_tree(r["rel"], n.rel)
            db.put(rel=n.rel, ino=n.st.st_ino, dev=n.st.st_dev)           # lsize/lmt unchanged -> edits show as modified
    for n, did_src in ptr_copies:                                        # Google files copied in the mirror
        try:
            copy_id(ctx, did_src, join(parent_of(n.rel), drive_name(name_of(n.rel))))
            total["up"] += 1
            did = True
            db.put(rel=n.rel, kind="f", size=n.st.st_size, mtime=n.st.st_mtime, hyd=1, gdoc=1, did="", **row_local_state(n.st))
            db.put(rel=parent_of(n.rel), listed=0)                       # the next listing gives the copy its own ID
        except GdError as e:
            fail(n.rel, str(e))
    if uploads:
        listing = os.path.join(ctx.tmp, f"up-{os.getpid()}.list")
        with open(listing, "w") as fh:
            fh.write("\n".join(u[0] for u in uploads) + "\n")
        size = sum(u[1].st_size for u in uploads)
        bar.msg = f"Uploading {len(uploads)} file(s) · {fmt_size(size)} to Google Drive"
        big = size >= 1 << 20 and sys.stderr.isatty()
        args2 = ["copy", ctx.tree, ctx.rpath(""), "--files-from-raw", listing]
        if big:
            with bar.paused():
                rc, _, err = rclone(ctx, args2 + ["--progress"], check=False, passthrough=True)
        else:
            rc, _, err = rclone(ctx, args2, check=False)
        os.unlink(listing)
        results = []
        if rc == 0:
            results = [(u, None) for u in uploads]
        else:                                                              # find out which ones failed
            def one(u):
                rclone(ctx, ["copyto", ctx.abs(u[0]), ctx.rpath(u[0])])
            results = run_levels(uploads, lambda u: 0, one)
        for u, e in results:
            rel, st, r = u
            if e:
                fail(rel, e)
                continue
            total["up"] += 1
            did = True
            db.put(rel=rel, kind="f", size=st.st_size, mtime=st.st_mtime, hyd=1, gdoc=0, **row_local_state(st))
    file_rm = [r for r in gone if r["kind"] == "f"]
    dir_rm = [r for r in gone if r["kind"] == "d"]
    perm = os.environ.get("BVK_GD_PERMANENT") == "1"
    extra = ["--drive-use-trash=false"] if perm else []
    if file_rm:
        listing = os.path.join(ctx.tmp, f"rm-{os.getpid()}.list")
        with open(listing, "w") as fh:
            fh.write("\n".join(rclone_rel(r) for r in file_rm) + "\n")
        bar.msg = f"Removing {len(file_rm)} file(s) from Google Drive"
        rc, _, err = rclone(ctx, ["delete", ctx.rpath(""), "--files-from-raw", listing, *extra], check=False)
        os.unlink(listing)
        if rc != 0:
            for r in file_rm:                                              # per file: tells which one failed
                rc1, _, e1 = rclone(ctx, ["deletefile", ctx.rpath(rclone_rel(r)), *extra], check=False)
                if rc1 not in (0, 4):                                      # 4 = already gone
                    fail(r["rel"], (e1.strip().splitlines() or ["delete failed"])[-1])
                    continue
                db.delete_tree(r["rel"]); total["rm"] += 1; did = True
        else:
            for r in file_rm:
                db.delete_tree(r["rel"]); total["rm"] += 1; did = True
    for it, err in run_levels(dir_rm, lambda r: r["rel"].count("/"), lambda r: _purge(ctx, r["rel"], extra)):
        if err:
            fail(it["rel"], err)
        else:
            db.delete_tree(it["rel"]); total["rm"] += 1; did = True
    # ── 5. folders that were fully handled look "clean" again ─────────────────────────────────────────
    for rel in set(scanned):
        if rel in failed_dirs or db.get(rel) is None:
            continue
        with contextlib.suppress(OSError):
            db.put(rel=rel, dmt=os.lstat(ctx.abs(rel)).st_mtime_ns)
    return did


def _purge(ctx, rel, extra):
    rc, out, err = rclone(ctx, ["purge", ctx.rpath(rel), *extra], check=False)
    if rc not in (0, 3, 4):
        raise GdError((err.strip().splitlines() or ["purge failed"])[-1])


