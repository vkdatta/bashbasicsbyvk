def cmd_copy(ctx, args):
    db = DB(ctx)
    src, dst = ctx.rel(args.src), ctx.rel(args.dst)
    row = db.get(src)
    if row is None:
        raise GdError(f"unknown in Drive: {src}")
    bar = Bar(f"Copying inside Google Drive · {name_of(src)}").start()
    ctx.bar = bar
    try:
        if row["kind"] == "f" and row["gdoc"] and row["did"]:
            copy_id(ctx, row["did"], join(parent_of(dst), drive_name(name_of(dst))))        # the Google file itself
        elif row["kind"] == "f":
            rclone(ctx, ["copyto", ctx.rpath(src), ctx.rpath(dst)])
        else:
            sync_dir(ctx, db, src, force=True, recursive=True)                               # know every Google file inside
            rclone(ctx, ["mkdir", ctx.rpath(dst)])
            rclone(ctx, ["copy", ctx.rpath(src), ctx.rpath(dst), "--drive-skip-gdocs", "--create-empty-src-dirs"])
            for r in sorted(db.under(src), key=lambda r: r["rel"]):
                if r["kind"] == "f" and r["gdoc"] and r["did"]:
                    inner = r["rel"][len(src) + 1:]
                    copy_id(ctx, r["did"], join(join(dst, parent_of(inner)) if parent_of(inner) else dst, drive_name(name_of(inner))))
        sync_dir(ctx, db, parent_of(dst), force=True)
        d2 = db.get(dst)
        if d2 is not None and d2["kind"] == "d":
            sync_dir(ctx, db, dst, force=True, recursive=True)
    finally:
        bar.stop()
    return 0


# ══════════════════════════════════════════════════════════════════════════════════════════════
#  export: the ONLY place a Google file becomes a Word / Excel / PowerPoint / PDF file  (Google's own converter)
# ══════════════════════════════════════════════════════════════════════════════════════════════
def _valid_export(path, fmt):
    import zipfile
    if os.path.getsize(path) == 0:
        return False
    if fmt in ("docx", "xlsx", "pptx", "odt", "ods", "odp", "epub", "zip"):
        return zipfile.is_zipfile(path)
    if fmt == "pdf":
        with open(path, "rb") as fh:
            return fh.read(5) == b"%PDF-"
    return True


def export_one(ctx, row, dest_file, fmt):
    ext = native_ext(row["rel"])
    if fmt not in EXPORT_FORMATS.get(ext, ()):
        raise GdError(f"{name_of(row['rel'])}: Google cannot convert a .{ext} file to .{fmt} "
                      f"(possible: {', '.join(EXPORT_FORMATS.get(ext, ())) or 'nothing — open it in Google'})")
    stage = tempfile.mkdtemp(prefix="ex-", dir=ctx.tmp)
    try:
        base = drive_name(name_of(row["rel"]))
        rpath = ctx.rpath(join(parent_of(row["rel"]), base + "." + fmt))
        out = os.path.join(stage, "out." + fmt)
        rc, _, err = rclone(ctx, ["copyto", rpath, out, "--ignore-size", "--ignore-checksum"], check=False, export=fmt)
        if rc != 0 or not os.path.isfile(out):
            tail = [l for l in (err or "").strip().splitlines() if l.strip()][-2:]
            raise GdError(f"{name_of(row['rel'])}: export failed — " + (" | ".join(tail) or f"rclone exit {rc}"))
        if not _valid_export(out, fmt):
            raise GdError(f"{name_of(row['rel'])}: Google returned an invalid .{fmt}; nothing was written")
        os.makedirs(os.path.dirname(dest_file) or ".", exist_ok=True)
        os.replace(out, dest_file) if os.stat(out).st_dev == os.stat(os.path.dirname(dest_file) or ".").st_dev \
            else shutil.move(out, dest_file)
    finally:
        shutil.rmtree(stage, ignore_errors=True)


def cmd_export(ctx, args):
    """export PATH... --to DIR [--format F] [--remove-pointers]   (files and folders; only Google files are converted)"""
    db = DB(ctx)
    todo, bad = [], 0
    for path in args.paths:
        rel = ctx.rel(path)
        row = db.get(rel)
        if row is None:
            say(f"❌ unknown in Drive: {rel}")
            bad += 1
            continue
        if row["kind"] == "d":
            sync_dir(ctx, db, rel, force=True, recursive=True)
            for r in sorted(db.under(rel), key=lambda r: r["rel"]):
                if r["kind"] == "f" and r["gdoc"]:
                    todo.append((r, join(name_of(rel), r["rel"][len(rel) + 1:])))
        elif row["gdoc"]:
            todo.append((row, name_of(rel)))
        else:
            say(f"📜  {name_of(rel)} is not a Google file — it is an ordinary file, nothing to convert.")
    done = 0
    for row, inner in todo:
        ext = native_ext(row["rel"])
        fmt = args.format or DEFAULT_EXPORT.get(ext)
        if not fmt:
            say(f"🔴  {name_of(row['rel'])}: Google has no file format for this kind (open it in Google).")
            bad += 1
            continue
        target_dir = os.path.join(args.to, parent_of(inner)) if parent_of(inner) else args.to
        stem = drive_name(name_of(inner))
        dest = os.path.join(target_dir, stem + "." + fmt)
        if os.path.exists(dest):
            n = 1
            while os.path.exists(os.path.join(target_dir, f"{stem}{n}.{fmt}")):
                n += 1
            dest = os.path.join(target_dir, f"{stem}{n}.{fmt}")
        try:
            with Bar(f"Converting {name_of(row['rel'])} with Google → .{fmt}"):
                export_one(ctx, row, dest, fmt)
        except GdError as e:
            say(f"❌ {e}")
            bad += 1
            continue
        done += 1
        print(dest)
        if args.remove_pointers:                       # a copy-out already carried the pointer along: drop it
            ptr = os.path.join(target_dir, name_of(inner))
            if read_pointer(ptr):
                with contextlib.suppress(OSError):
                    os.unlink(ptr)
    if done:
        say(f"💫 {done} Google file(s) converted by Google — the Drive copies are unchanged.")
    return 1 if bad else 0


# ══════════════════════════════════════════════════════════════════════════════════════════════
#  recover: find files that older versions of this tool damaged, and where the good copy can still be
#     READ-ONLY: nothing in Drive is changed.  It writes <profile-dir>/recover-report.tsv
# ══════════════════════════════════════════════════════════════════════════════════════════════
_OOXML = (".docx", ".xlsx", ".pptx")
_ZIPPED = _OOXML + (".odt", ".ods", ".odp", ".epub")


def _damage(path, name):
    """why a downloaded Office file is broken, or '' when it is fine"""
    import zipfile
    try:
        size = os.path.getsize(path)
    except OSError:
        return "could not be read"
    if size == 0:
        return "empty (0 bytes)"
    with open(path, "rb") as fh:
        head = fh.read(65536)
    if head.count(b"\0") == len(head):
        return "only zero bytes (a not-downloaded placeholder was uploaded)"
    if not zipfile.is_zipfile(path):
        return "not a valid Office/zip file (truncated or wrong content)"
    try:
        with zipfile.ZipFile(path) as z:
            bad = z.testzip()
            if bad:
                return f"damaged inside ({bad})"
            if name.lower().endswith(_OOXML) and "[Content_Types].xml" not in z.namelist():
                return "zip without [Content_Types].xml (not a real Word/Excel/PowerPoint file)"
    except Exception as e:
        return f"unreadable zip ({e.__class__.__name__})"
    return ""


def cmd_recover(ctx, args):
    base = ctx.rel(args.path) if args.path else ""
    say(f"🔎 Listing Office files under {ctx.remote}:/{base} ...")
    rc, out, err = rclone(ctx, ["lsjson", ctx.rpath(base), "-R", "--files-only", "--metadata"], check=False)
    if rc != 0:
        raise GdError("could not list the Drive: " + ((err or "").strip().splitlines() or ["?"])[-1])
    files = []
    for e in json.loads(out or "[]"):
        ct = (e.get("Metadata") or {}).get("content-type", "")
        p = e.get("Path", "")
        if p.lower().endswith(_ZIPPED) and not ct.startswith(_GA):
            files.append((p, int(e.get("Size", 0) or 0), e.get("ID", "")))
    # what is in the Drive trash (a Google file that an older version replaced by an export lands there)
    rc, tout, _ = rclone(ctx, ["lsjson", ctx.rpath(base), "-R", "--files-only", "--metadata", "--drive-trashed-only"], check=False)
    trashed = {}
    if rc == 0:
        for e in json.loads(tout or "[]"):
            if ((e.get("Metadata") or {}).get("content-type", "")).startswith(_GA):
                nm = e.get("Path", "")
                trashed[os.path.splitext(nm[:-4] if nm.endswith(".url") else nm)[0]] = nm
    if not files:
        say("💫 No Office files found there.")
        return 0
    total = sum(f[1] for f in files)
    if total > int(os.environ.get("BVK_GD_CONFIRM_MB", "200")) * 1024 * 1024 and not args.yes:
        if not ask_yes(f"☁️  Download {len(files)} file(s), {fmt_size(total)} to check them (nothing is changed in Drive)?"):
            say("🚫 Cancelled.")
            return 4
    stage = tempfile.mkdtemp(prefix="rc-", dir=ctx.tmp)
    broken = []
    try:
        for i, (p, size, fid) in enumerate(files, 1):
            with Bar(f"Checking {i}/{len(files)} · {name_of(p)}"):
                dst = os.path.join(stage, "f")
                if os.path.exists(dst):
                    os.unlink(dst)
                rc, _, e = rclone(ctx, ["copyto", ctx.rpath(join(base, p)), dst, "--ignore-size", "--ignore-checksum"], check=False)
            why = _damage(dst, p) if rc == 0 and os.path.isfile(dst) else "could not be downloaded"
            if why and why != "could not be downloaded":
                stem = os.path.splitext(join(base, p))[0]
                broken.append((join(base, p), size, why, trashed.get(stem, "")))
    finally:
        shutil.rmtree(stage, ignore_errors=True)
    rep_path = os.path.join(ctx.pdir, "recover-report.tsv")
    with open(rep_path, "w") as fh:
        fh.write("path\tsize\tproblem\tgoogle_file_in_trash\n")
        for b in broken:
            fh.write("\t".join(str(x) for x in b) + "\n")
    say(f"📋 Checked {len(files)} Office file(s): {len(broken)} damaged.   Report: {rep_path}")
    for pth, size, why, tr in broken[:40]:
        say(f"   ✗ {pth}  ({fmt_size(size)}) — {why}" + (f"\n       ↳ the original Google file is in Drive Trash as '{tr}': restore it there" if tr else ""))
    if len(broken) > 40:
        say(f"   … and {len(broken) - 40} more in the report")
    if broken:
        say("   Restore: Drive web → Trash → Restore the Google original (if listed above, kept 30 days), or on the damaged "
            "file: right-click → Manage versions → download/restore an earlier version.")
    return 1 if broken else 0


