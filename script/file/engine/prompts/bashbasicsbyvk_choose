#!/usr/bin/env bash
# bashbasicsbyvk_choose — THE one-of-many / many-of-many question for every tool that runs as its own process (bash or python):
# the app's native choice menu (_bvk_menu), the same look as Settings and every in-app question.  The sibling of bashbasicsbyvk_yn and bashbasicsbyvk_ask.
#
#   answer=$(bashbasicsbyvk_choose "Question?" [-t "Title"] [-i "emoji"] [-d key] [-k] [-m] [-b] key:Label key:Label ...)
#
#   stdout = the chosen key (-m: the chosen keys, space separated; none ticked = an empty line); the menu is drawn on the TERMINAL, also when the
#            caller's stdin / stdout are pipes (so command substitution works).
#   exit 0 = answered · 2 = no answer (q / u / Ctrl-D) · 3 = cannot ask (the menu is not installed: a broken install) · 4 = u, with -b
#   -d key  the row that starts highlighted and is taken by a bare Enter (leave it out and nothing is highlighted)
#   -k      also print the answer keys on a second footer line (c/x) Cancel ...)
#   -m      many-of-many: rows are ticked (a number toggles; the app's grammar 1,3-5 · a · a-2 sets the selection), then d / Done
#   -b      a caller that chains questions (a _mc_steps / ask.steps flow): u (back) exits 4 instead of 2 (same as bashbasicsbyvk_yn -b / bashbasicsbyvk_ask -b)
#
# A row is  key:Label  — the key is what comes back (1, 2, patch, a ...), the label may contain colons.  `key|alias|alias:Label` adds typed aliases.
# Callers keep a plain `read` only as the last fallback for exit 3, marked  # bvk-read-ok: ...  (AGENTS.md rules 6, 16 and 18).
# shellcheck disable=SC1090
declare -F _bvk_menu >/dev/null 2>&1 || source "_3bvk_import_yn.sh" 2>/dev/null
declare -F _bvk_menu >/dev/null 2>&1 || { echo "bashbasicsbyvk_choose: the choice menu is not installed (reinstall bashbasicsbyvk)." >&2; exit 3; }
[ -n "${1:-}" ] || { echo 'usage: bashbasicsbyvk_choose "Question?" [-t Title] [-i emoji] [-d key] [-k] [-m] [-b] key:Label ...' >&2; exit 3; }
_ch_q="$1"; shift; _ch_b=0; _ch_flags=(); _ch_rows=()
while [ "$#" -gt 0 ]; do
  case "$1" in
    -b) _ch_b=1; shift ;;
    -t|-i|-d) _ch_flags+=("$1" "${2-}"); shift 2 ;;
    -k|-m) _ch_flags+=("$1"); shift ;;
    *) _ch_rows+=("$1"); shift ;;
  esac
done
[ "${#_ch_rows[@]}" -ge 2 ] || { echo "bashbasicsbyvk_choose: give at least two key:Label rows." >&2; exit 3; }
exec 3>&1                                                    # the caller's stdout: only the answer goes there
[ -t 0 ] || { [ -r /dev/tty ] && exec </dev/tty; }
[ -t 1 ] || { [ -w /dev/tty ] && exec >/dev/tty; }
_ch_ans=""
if _bvk_menu _ch_ans -q "$_ch_q" "${_ch_flags[@]}" -- "${_ch_rows[@]}"; then
  printf '%s\n' "$_ch_ans" >&3
  exit 0
fi
[ "$_ch_b" = 1 ] && _bvk_back && exit 4
exit 2
