#!/usr/bin/env python3
"""bashbasicsbyvk_mapgen — the command-map "class list maker".

  bashbasicsbyvk_mapgen [--root DIR] [--dry]

Reads  menus.list  and the project sources, and for every menu writes
    <menu>menucommands.sh   the commands only that menu's loop handles   (cmd_def …)
    <menu>.map              the wiring: every main command is listed EXPLICITLY
It only ever ADDS lines.  Anything already in a file (descriptions you wrote,
a block() you chose, a re-mapped key) is kept exactly as it is.
"""
import os, re, sys, glob

HERE = os.path.dirname(os.path.abspath(__file__))
args = sys.argv[1:]
DRY = "--dry" in args
ROOT = args[args.index("--root") + 1] if "--root" in args else None
if ROOT is None:
    d = HERE
    while d != "/" and not os.path.isdir(os.path.join(d, "script")):
        d = os.path.dirname(d)
    ROOT = os.path.join(d, "script") if os.path.isdir(os.path.join(d, "script")) else HERE
OUT = HERE

DEFAULT_DESC = {
    "u": "Back", "q": "Quit", "rf": "Refresh the list", "-h": "Help", "disk": "Disk usage", "ram": "Memory usage",
    "x": "Close", "b": "Back", "h": "Home", "c": "Create", "r": "Remove", "l": "Link", "m": "Move",
}

# ---------------------------------------------------------------- read main defs
def read_defs(path):
    defs = {}
    rx = re.compile(r'^cmd_def\s+(\S+)\s+(\S+)\s+(\S+)\s+(\S+)\s*(?:"([^"]*)")?\s*(?:"([^"]*)")?')
    for l in open(path, encoding="utf-8"):
        m = rx.match(l)
        if m:
            defs[m.group(1)] = dict(kind=m.group(2), handler=m.group(3), cls=m.group(4), desc=m.group(5) or "", ex=m.group(6) or "")
    return defs

main_defs = read_defs(os.path.join(OUT, "maincommands.sh"))

# ---------------------------------------------------------------- find function sources
sources = {}
for f in glob.glob(os.path.join(ROOT, "**", "*"), recursive=True):
    if not os.path.isfile(f) or f.endswith((".c", ".h", ".md", ".txt", ".map", ".list", ".xlsx")) or "bvk-ls" in f:
        continue
    try:
        sources[f] = open(f, encoding="utf-8").read().split("\n")
    except Exception:
        pass

def find_function(name):
    rx = re.compile(r'^' + re.escape(name) + r'\(\)\s*\{')
    for f, lines in sources.items():
        for i, l in enumerate(lines):
            if rx.match(l):
                j = i + 1
                while j < len(lines) and not lines[j].startswith("}"):
                    j += 1
                return f, lines[i:j + 1]
    return None, None

def file_footer_labels(lines):
    lab = {}
    for l in lines:
        for k, v in re.findall(r'"([^":|\s]{1,8}):([^"]+)"', l):
            lab.setdefault(k, v.replace("_", " "))
        for k, v in re.findall(r"(?<![\w-])([A-Za-z][A-Za-z0-9-]{0,5}):([A-Za-z][A-Za-z_]+)", l):
            if l.lstrip().startswith(("_mc_footer", "_mc_keyed")):
                lab.setdefault(k, v.replace("_", " "))
    return lab

SUBJ = re.compile(r'^case\s+"?\$\{?([A-Za-z_0-9]+)\}?"?\s+in')
ARM = re.compile(r'^\s*([^\s()#;][^()]*?)\)\s*(?:[^)]|$)')

def harvest(lines):
    """-> list of (key, kind) from `case "$…choice…" in` arms of this function"""
    found = []
    stack = []   # (indent, takes)
    for l in lines:
        st = l.strip()
        m = SUBJ.match(st)
        if m:
            subj = m.group(1)
            stack.append((len(l) - len(l.lstrip()), bool(re.search(r'choice|^c$|^cmd$|^key$|^typed$|^_?k$', subj))))
            continue
        if st == "esac" and stack:
            stack.pop(); continue
        if not stack or not stack[-1][1]:
            continue
        ind = len(l) - len(l.lstrip())
        if ind > stack[-1][0] + 12:
            continue
        m = ARM.match(l)
        if not m:
            continue
        pat = m.group(1).strip()
        for tok in re.split(r'\|', pat):
            tok = tok.strip().replace("\\ ", " ")
            if not tok or tok.startswith(("_", "$", '"', "[")) or "$" in tok or tok in ("*", "(*"):
                continue
            if re.fullmatch(r'[0-9]+', tok):
                continue
            if tok.startswith("__"):
                continue
            kind = "exact"
            if tok.endswith(" *") or tok.endswith(".*"):
                tok = tok[:-2]; kind = "word"
            elif tok.endswith("*"):
                tok = tok[:-1]; kind = "prefix"
            if not tok or not re.fullmatch(r'[A-Za-z.=-][A-Za-z0-9.=_-]*', tok):
                continue
            found.append((tok, kind))
    out, seen = [], set()
    for k, kd in found:
        key = k.lower()
        # a bare word next to its own word/prefix form is just that form
        if kd == "exact" and any(k2.lower() == key and kd2 != "exact" for k2, kd2 in found):
            continue
        if (key, kd) not in seen:
            seen.add((key, kd)); out.append((k, kd))
    return out

# ---------------------------------------------------------------- existing files
def existing_defs(path):
    ids = set()
    if os.path.isfile(path):
        for l in open(path, encoding="utf-8"):
            m = re.match(r'^cmd_def\s+(\S+)', l)
            if m: ids.add(m.group(1).lower())
    return ids

def existing_wires(path):
    keys = set()
    if os.path.isfile(path):
        for l in open(path, encoding="utf-8"):
            l = l.split("#")[0].strip()
            m = re.match(r'^(\S+)\s+\.mapto\(\)', l)
            if m: keys.add(m.group(1).lower().rstrip("*"))
    return keys

def write(path, text, append):
    if DRY:
        print(f"--- {os.path.basename(path)} ({'append' if append else 'new'})"); print(text); return
    with open(path, "a" if append else "w", encoding="utf-8") as fh:
        fh.write(text)

# ---------------------------------------------------------------- per menu
report = []
for raw in open(os.path.join(OUT, "menus.list"), encoding="utf-8"):
    raw = raw.split("#")[0].strip()
    if not raw: continue
    name, func, kind, back = [x.strip() for x in raw.split("|")]
    mapf = os.path.join(OUT, f"{name}.map")
    cmdf = os.path.join(OUT, f"{name}menucommands.sh")
    cmdsfile = f"{name}menucommands.sh"
    local, labels, uses_filter, body_text = [], {}, False, ""
    if func != "-":
        src, lines = find_function(func)
        if lines is None:
            report.append(f"! {name}: function {func} not found"); continue
        local = harvest(lines)
        labels = file_footer_labels(sources[src])
        body_text = "\n".join(lines)
        uses_filter = "_read_choice_filtered" in body_text or "=)" in body_text
    # ---- <menu>menucommands.sh
    have = existing_defs(cmdf)
    new_defs = []
    for key, kd in local:
        if key.lower() in have: continue
        if name == "main": continue
        md = main_defs.get(key)
        desc = labels.get(key) or labels.get(key.rstrip("-")) or (md["desc"] if md and key not in ("u", "q") else "") or DEFAULT_DESC.get(key, "")
        ex = f' "{md["ex"]}"' if md and md["ex"] else ""
        new_defs.append(f'cmd_def {key:<8} {kd:<7} -  local  "{desc or "(describe me)"}"{ex}\n')
        have.add(key.lower())
    if name != "main" and (new_defs or not os.path.isfile(cmdf)):
        head = "" if os.path.isfile(cmdf) else (
            f"#!/usr/bin/env bash\n# {cmdsfile} — commands that exist ONLY in the '{name}' menu (handler '-' = its own loop).\n"
            f"# Edit the descriptions: they are the live suggestion text.\n")
        write(cmdf, head + "".join(new_defs), os.path.isfile(cmdf))
    # ---- <menu>.map
    wired = existing_wires(mapf)
    lines_out = []
    if not os.path.isfile(mapf):
        lines_out.append(f"# {name}.map — wiring for the '{name}' {kind}\n@menu   {name}\n"
                         + (f"@func   {func}\n" if func != "-" else "")
                         + f"@kind   {kind}\n@back   {back}\n@parent main\n\n")
    if name == "main":
        for id_, d in main_defs.items():
            if id_.lower() in wired: continue
            lines_out.append(f"{id_:<10} .mapto()  {id_:<10} from maincommands.sh\n")
    else:
        local_keys = {k.lower() for k, _ in local}
        # this menu's own commands
        for key, kd in local:
            if key.lower() in wired: continue
            lines_out.append(f"{key:<10} .mapto()  {key:<10} from {cmdsfile}\n")
            wired.add(key.lower())
        # every main command, explicitly
        for id_, d in main_defs.items():
            if id_.lower() in wired or id_.lower() in local_keys: continue
            cls = d["cls"]
            if kind == "prompt":
                # prompts: only navigation is allowed out of a prompt; everything else is blocked
                if id_ in ("s", "h", "q") or cls == "tool":
                    lines_out.append(f"{id_:<10} .mapto()  {id_:<10} from maincommands.sh\n")
                elif id_ == "u":
                    lines_out.append(f"{id_:<10} .mapto()  back()\n")
                else:
                    lines_out.append(f"{id_:<10} .mapto()  block()\n")
                continue
            if id_ == "u":
                lines_out.append(f"{id_:<10} .mapto()  back()\n")
                continue
            if kind == "menu" and not local and cls not in ("nav", "util", "tool", "filter"):
                lines_out.append(f"{id_:<10} .mapto()  {id_:<10} from maincommands.sh   # AUTO: loop not analysed — decide: keep or block()\n")
                continue
            if cls in ("nav", "util", "tool"):
                lines_out.append(f"{id_:<10} .mapto()  {id_:<10} from maincommands.sh\n")
            elif cls == "filter":
                if uses_filter: lines_out.append(f"{id_:<10} .mapto()  {id_:<10} from maincommands.sh\n")
                else:           lines_out.append(f"{id_:<10} .mapto()  block()\n")
            else:
                key_rx = re.escape(id_.rstrip("-")) if id_.endswith("-") else re.escape(id_)
                mentioned = bool(re.search(r'(?<![\w.-])' + key_rx + r'(?![\w])', body_text)) if body_text else False
                if mentioned and id_ not in ("u", "c", "d", "r", "t", "f", "z", "s", "i", "h", "q"):
                    lines_out.append(f"{id_:<10} .mapto()  {id_:<10} from maincommands.sh   # loop mentions it — kept as before\n")
                else:
                    lines_out.append(f"{id_:<10} .mapto()  block()\n")
    if lines_out:
        write(mapf, "".join(lines_out), os.path.isfile(mapf))
    report.append(f"✓ {name}: {len(local)} own command(s), map {'updated' if os.path.isfile(mapf) else 'created'}")
print("\n".join(report))
