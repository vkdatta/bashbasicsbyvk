#!/usr/bin/env python3
"""
bashbasicsbyvk_recents_daemon.py
─────────────────────────────────
Watches the filesystem with inotify (via watchdog) and maintains a
rolling list of the 100 most recently modified/created files in:
    ~/.bashbasicsbyvk/recents.list

Format: one absolute path per line, newest first.

Usage (managed by bashbasicsbyvk_switch.sh):
    python3 <this file> [watch_root1 watch_root2 ...]
    Default watch roots: $HOME

The process writes its PID to ~/.bashbasicsbyvk/recents.pid on start
and removes it on clean exit (SIGTERM / SIGINT).
"""

import os
import sys
import signal
import threading
import time

from collections import OrderedDict
from pathlib import Path

try:
    from watchdog.observers.inotify import InotifyObserver as Observer
except ImportError:
    from watchdog.observers import Observer

from watchdog.events import (
    FileSystemEventHandler,
    FileCreatedEvent,
    FileModifiedEvent,
    FileMovedEvent,
)

# ── Config ─────────────────────────────────────────────────────────────────────
BVK_DIR    = Path.home() / ".bashbasicsbyvk"
LIST_FILE  = BVK_DIR / "recents.list"
PID_FILE   = BVK_DIR / "recents.pid"
MAX_RECENT = 100
FLUSH_INTERVAL = 2.0   # seconds between disk writes (batch updates)

# Paths/patterns to ignore
IGNORE_PREFIXES = (
    str(BVK_DIR),
    str(Path.home() / ".cache"),
    str(Path.home() / ".local/share/recently-used"),
    "/proc", "/sys", "/dev", "/run", "/tmp",
)
IGNORE_SUFFIXES = (
    ".swp", ".swpx", ".tmp", "~", ".lock", ".pid",
    ".pyc", ".pyo",
)
IGNORE_NAMES = {
    "recents.list", "recents.pid", "lastdir",
    ".bash_history", ".python_history",
}

# ── Shared state ───────────────────────────────────────────────────────────────
# Use OrderedDict as an ordered set: key=path, value=None, newest at front
_lock   = threading.Lock()
_recent: OrderedDict = OrderedDict()
_dirty  = threading.Event()

def _should_ignore(path: str) -> bool:
    name = os.path.basename(path)
    if name.startswith("."):
        return True
    if name in IGNORE_NAMES:
        return True
    for sfx in IGNORE_SUFFIXES:
        if path.endswith(sfx):
            return True
    for pfx in IGNORE_PREFIXES:
        if path.startswith(pfx):
            return True
    return False

def _record(path: str):
    if _should_ignore(path):
        return
    if not os.path.isfile(path):
        return
    with _lock:
        # Move to front (most recent)
        _recent.pop(path, None)
        # Insert at beginning by rebuilding (OrderedDict has no move_to_front)
        new = OrderedDict()
        new[path] = None
        new.update(_recent)
        _recent.clear()
        _recent.update(new)
        # Trim
        while len(_recent) > MAX_RECENT:
            _recent.popitem(last=True)
    _dirty.set()

# ── Watchdog event handler ─────────────────────────────────────────────────────
class RecentHandler(FileSystemEventHandler):
    def on_created(self, event):
        if not event.is_directory:
            _record(event.src_path)

    def on_modified(self, event):
        if not event.is_directory:
            _record(event.src_path)

    def on_moved(self, event):
        if not event.is_directory:
            _record(event.dest_path)

# ── Disk flusher thread ────────────────────────────────────────────────────────
def _flusher():
    while True:
        _dirty.wait()
        _dirty.clear()
        time.sleep(FLUSH_INTERVAL)   # debounce: batch rapid edits
        _flush_to_disk()

def _flush_to_disk():
    with _lock:
        lines = list(_recent.keys())
    tmp = LIST_FILE.with_suffix(".tmp")
    try:
        with open(tmp, "w") as f:
            f.write("\n".join(lines))
            if lines:
                f.write("\n")
        os.replace(tmp, LIST_FILE)   # atomic rename
    except OSError:
        pass

# ── Bootstrap: load existing list so we don't start cold ──────────────────────
def _load_existing():
    if not LIST_FILE.exists():
        return
    try:
        with open(LIST_FILE) as f:
            for line in f:
                p = line.rstrip("\n")
                if p and os.path.isfile(p):
                    _recent[p] = None
        # Trim to max
        while len(_recent) > MAX_RECENT:
            _recent.popitem(last=True)
    except OSError:
        pass

# ── Cleanup ────────────────────────────────────────────────────────────────────
def _cleanup(signum=None, frame=None):
    _flush_to_disk()
    try:
        PID_FILE.unlink()
    except OSError:
        pass
    sys.exit(0)

# ── Main ───────────────────────────────────────────────────────────────────────
def main():
    BVK_DIR.mkdir(parents=True, exist_ok=True)

    # Single-instance guard — plain PID file, no flock
    if PID_FILE.exists():
        try:
            old_pid = int(PID_FILE.read_text().strip())
            os.kill(old_pid, 0)   # raises if process is gone
            sys.exit(0)           # genuinely already running
        except (ProcessLookupError, ValueError, OSError):
            pass                  # stale PID — overwrite below
    PID_FILE.write_text(str(os.getpid()) + "\n")

    signal.signal(signal.SIGTERM, _cleanup)
    signal.signal(signal.SIGINT,  _cleanup)

    _load_existing()

    watch_roots = sys.argv[1:] if len(sys.argv) > 1 else [str(Path.home())]

    observer = Observer()
    handler  = RecentHandler()
    for root in watch_roots:
        if os.path.isdir(root):
            observer.schedule(handler, root, recursive=True)

    observer.start()

    # Start flusher thread
    t = threading.Thread(target=_flusher, daemon=True)
    t.start()

    try:
        while True:
            time.sleep(1)
            if not observer.is_alive():
                break
    finally:
        observer.stop()
        observer.join()
        _cleanup()

if __name__ == "__main__":
    main()
