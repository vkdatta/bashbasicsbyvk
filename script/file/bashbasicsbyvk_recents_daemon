#!/usr/bin/env python3
"""
bashbasicsbyvk_recents_daemon
──────────────────────────────
Self-bootstrapping persistent daemon that tracks recently modified files.

First run (called from main script o):
  • Detects environment (systemd/user, Termux, plain Linux)
  • Installs itself as a persistent service if possible
  • Starts itself and stays alive

Subsequent runs / reboots:
  • systemd (or ~/.bashrc on Termux) wakes it automatically
  • Main script o just does a liveness check and wakes if dead

Output:
  ~/.bashbasicsbyvk/recents.list   — newest-first, max 100 paths
  ~/.bashbasicsbyvk/recents.pid    — PID of running daemon
"""

import os
import sys
import signal
import subprocess
import threading
import time
from collections import OrderedDict
from pathlib import Path

# ── Paths ──────────────────────────────────────────────────────────────────────
HOME       = Path.home()
BVK_DIR    = HOME / ".bashbasicsbyvk"
LIST_FILE  = BVK_DIR / "recents.list"
PID_FILE   = BVK_DIR / "recents.pid"
THIS_FILE  = Path(os.path.abspath(__file__))

MAX_RECENT    = 100
FLUSH_DELAY   = 2.0   # seconds — debounce rapid edits

# ── Environment detection ──────────────────────────────────────────────────────

def _is_termux():
    return "com.termux" in str(HOME) or os.environ.get("TERMUX_VERSION") is not None

def _has_systemd_user():
    try:
        r = subprocess.run(
            ["systemctl", "--user", "is-system-running"],
            capture_output=True, timeout=3
        )
        # Only trust it if stdout actually says something meaningful
        out = r.stdout.decode().strip()
        return r.returncode in (0, 1) and out in ("running", "degraded")
    except Exception:
        return False

# ── Self-bootstrap ─────────────────────────────────────────────────────────────

SERVICE_NAME = "bashbasicsbyvk-recents"

def _systemd_unit_path():
    cfg = Path(os.environ.get("XDG_CONFIG_HOME", HOME / ".config"))
    return cfg / "systemd" / "user" / f"{SERVICE_NAME}.service"

def _install_systemd():
    unit = _systemd_unit_path()
    unit.parent.mkdir(parents=True, exist_ok=True)
    python = sys.executable
    unit.write_text(f"""[Unit]
Description=bashbasicsbyvk recents file watcher
After=default.target

[Service]
Type=simple
ExecStart={python} {THIS_FILE}
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
""")
    try:
        subprocess.run(["systemctl", "--user", "daemon-reload"], timeout=5)
        subprocess.run(["systemctl", "--user", "enable", SERVICE_NAME], timeout=5)
        subprocess.run(["systemctl", "--user", "start",  SERVICE_NAME], timeout=5)
        return True
    except Exception:
        return False

def _install_termux_bashrc():
    """Append a one-liner to ~/.bashrc that wakes the daemon on every new shell."""
    bashrc = HOME / ".bashrc"
    marker = "# bashbasicsbyvk-recents-daemon"
    text   = bashrc.read_text() if bashrc.exists() else ""
    if marker in text:
        return   # already installed
    line = (
        f"\n{marker}\n"
        f"( pgrep -f '{THIS_FILE.name}' > /dev/null 2>&1 ) || "
        f"( python '{THIS_FILE}' --daemon </dev/null >/dev/null 2>&1 & disown )\n"
    )
    with open(bashrc, "a") as f:
        f.write(line)

def bootstrap():
    """
    Called when no daemon is running.
    Install persistence, then re-exec as the daemon.
    """
    BVK_DIR.mkdir(parents=True, exist_ok=True)

    if _is_termux():
        _install_termux_bashrc()
        # On Termux we can't use systemd; just start ourselves in the background
        # and let the bashrc hook handle future sessions.
        _start_background()
        sys.exit(0)

    if _has_systemd_user():
        if _install_systemd():
            # systemd took over — we're done
            sys.exit(0)

    # Fallback: plain background launch (Docker, Cloud Shell, etc.)
    _start_background()
    sys.exit(0)

def _start_background():
    """Launch this script as a detached background process.
    Uses Popen with start_new_session=True — works on Termux, containers,
    Cloud Shell, and plain Linux without needing os.fork().
    """
    proc = subprocess.Popen(
        [sys.executable, str(THIS_FILE), "--daemon"],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        stdin=subprocess.DEVNULL,
        start_new_session=True,
    )
    # Give the child a moment to write its PID file before we exit
    time.sleep(0.5)
    return proc.pid

# ── Liveness check ─────────────────────────────────────────────────────────────

def is_alive():
    if not PID_FILE.exists():
        return False
    try:
        pid = int(PID_FILE.read_text().strip())
        os.kill(pid, 0)
        return True
    except (ValueError, ProcessLookupError, PermissionError, OSError):
        return False

# ── Watcher ────────────────────────────────────────────────────────────────────

IGNORE_PREFIXES = (
    str(BVK_DIR),
    str(HOME / ".cache"),
    str(HOME / ".local/share/recently-used"),
    "/proc", "/sys", "/dev", "/run", "/tmp",
)
IGNORE_SUFFIXES = (".swp", ".swpx", ".tmp", "~", ".lock", ".pid", ".pyc", ".pyo")
IGNORE_NAMES    = {"recents.list", "recents.pid", "lastdir", ".bash_history", ".python_history"}

_lock   = threading.Lock()
_recent : OrderedDict = OrderedDict()
_dirty  = threading.Event()

def _should_ignore(path: str) -> bool:
    name = os.path.basename(path)
    if name.startswith("."):
        return True
    if name in IGNORE_NAMES:
        return True
    for s in IGNORE_SUFFIXES:
        if path.endswith(s):
            return True
    for p in IGNORE_PREFIXES:
        if path.startswith(p):
            return True
    return False

def _record(path: str):
    if _should_ignore(path) or not os.path.isfile(path):
        return
    with _lock:
        _recent.pop(path, None)
        new = OrderedDict(); new[path] = None; new.update(_recent)
        _recent.clear(); _recent.update(new)
        while len(_recent) > MAX_RECENT:
            _recent.popitem(last=True)
    _dirty.set()

def _flusher():
    while True:
        _dirty.wait()
        _dirty.clear()
        time.sleep(FLUSH_DELAY)
        _flush_to_disk()

def _flush_to_disk():
    with _lock:
        lines = list(_recent.keys())
    tmp = LIST_FILE.with_suffix(".tmp")
    try:
        tmp.write_text("\n".join(lines) + ("\n" if lines else ""))
        os.replace(tmp, LIST_FILE)
    except OSError:
        pass

def _load_existing():
    if not LIST_FILE.exists():
        return
    try:
        for line in LIST_FILE.read_text().splitlines():
            if line and os.path.isfile(line):
                _recent[line] = None
        while len(_recent) > MAX_RECENT:
            _recent.popitem(last=True)
    except OSError:
        pass

def _cleanup(signum=None, frame=None):
    _flush_to_disk()
    try: PID_FILE.unlink()
    except OSError: pass
    sys.exit(0)

LOG_FILE = BVK_DIR / "recents.log"

def _log(msg):
    try:
        with open(LOG_FILE, "a") as f:
            f.write(f"{time.strftime('%Y-%m-%d %H:%M:%S')} {msg}\n")
    except OSError:
        pass

def run_daemon():
    """The actual watcher loop. Runs in foreground; systemd/fork supervises it."""
    BVK_DIR.mkdir(parents=True, exist_ok=True)

    # Write PID before anything else so caller's liveness check succeeds
    PID_FILE.write_text(str(os.getpid()) + "\n")

    signal.signal(signal.SIGTERM, _cleanup)
    signal.signal(signal.SIGINT,  _cleanup)

    _log(f"daemon started pid={os.getpid()}")

    _load_existing()

    watch_roots = [str(HOME)]

    try:
        from watchdog.observers.inotify import InotifyObserver as Observer
    except ImportError:
        from watchdog.observers import Observer

    from watchdog.events import FileSystemEventHandler

    class _Handler(FileSystemEventHandler):
        def on_created(self, e):
            if not e.is_directory: _record(e.src_path)
        def on_modified(self, e):
            if not e.is_directory: _record(e.src_path)
        def on_moved(self, e):
            if not e.is_directory: _record(e.dest_path)

    observer = Observer()
    handler  = _Handler()
    for root in watch_roots:
        if os.path.isdir(root):
            observer.schedule(handler, root, recursive=True)

    try:
        observer.start()
        _log(f"observer started watching {watch_roots}")
    except Exception as e:
        _log(f"observer failed to start: {e}")
        _cleanup()
        return

    t = threading.Thread(target=_flusher, daemon=True)
    t.start()

    try:
        while observer.is_alive():
            time.sleep(1)
        _log("observer died unexpectedly")
    finally:
        observer.stop()
        observer.join()
        _cleanup()

# ── Entry point ────────────────────────────────────────────────────────────────

def main():
    daemon_mode = "--daemon" in sys.argv

    if daemon_mode:
        # We are the daemon — just run the watcher
        run_daemon()
        return

    # Called from main script o (or manually):
    # If already alive, nothing to do.
    if is_alive():
        return

    # Not alive — bootstrap persistence and start
    bootstrap()

if __name__ == "__main__":
    main()
