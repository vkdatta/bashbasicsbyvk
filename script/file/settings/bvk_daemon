_PLUGIN_EXT = frozenset((
    ".crx",".xpi",".safariextz",".vsix",".visx",".natvis",
    ".sublime-package",".plugin",".bundle",".kext",".mdimporter",
    ".addon",".addin",".adp",".vst",".vst3",".au",".lv2",".ladspa",".dssi",
    ".sketchplugin",".figma",".xdx",
