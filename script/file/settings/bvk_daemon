#!/usr/bin/env python3
"""
bvk_daemon.py — BashBasicsByVK filesystem metadata daemon
━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

TWO MODES
─────────
  # Start the daemon (bash does this automatically on first query):
  python3 bvk_daemon.py --daemon

  # Query the daemon (used by bvk_client.sh):
  python3 bvk_daemon.py LIST   /path/to/dir <show_hidden:0|1>
  python3 bvk_daemon.py PING
  python3 bvk_daemon.py INVALIDATE /path/to/dir

HOW IT WORKS — SINGLE RECURSIVE SCAN
──────────────────────────────────────
  When you LIST ~/home, the daemon performs ONE full recursive walk of the
  entire tree rooted there.  Every subdirectory encountered during that walk
  gets its own cache entry written to disk.  When you later enter ~/claude,
  the cache already exists — no re-scan, instant response.

  Cache hit path:
    LIST ~/home        → cache miss → full recursive scan → cache written
                         for ~/home AND every subdir inside it
    LIST ~/home/claude → cache hit  → read JSON, done in <5 ms

  Invalidation:
    inotify fires on any directory → that directory's cache is marked dirty
    → next LIST of that specific dir rebuilds only that one level

PROGRESS FORMAT
───────────────
  PROGRESS:<files>:<folders>:<bytes>
  No percentage, no estimate.  Exact counts of what has been seen so far,
  updated at every single file and folder the walker touches.

WIRE PROTOCOL
─────────────
  Request  (one line, tab-separated): CMD [\targ1 [\targ2]]
  Response (LIST): one line per entry, pipe-separated fields, then "END\n"
    Format: <abs_path>|<size_bytes>|<mtime_epoch>|<children>|<icon_type>
    children: -1 for files, count of immediate entries for directories
    icon_type: dir | archive | image | plugin | exec | plain | shortcut
"""

import os
import sys
import json
import time
import socket
import hashlib
import threading
import signal
import struct
import stat as stat_mod
import fcntl
from pathlib import Path
from concurrent.futures import ThreadPoolExecutor, wait, FIRST_COMPLETED, ALL_COMPLETED

# ── Paths ──────────────────────────────────────────────────────────────────────

_xdg_cfg   = os.environ.get("XDG_CONFIG_HOME", os.path.join(os.path.expanduser("~"), ".config"))
_xdg_cache = os.environ.get("XDG_CACHE_HOME",  os.path.join(os.path.expanduser("~"), ".cache"))

CONFIG_DIR = Path(_xdg_cfg)   / "bashbasicsbyvk"
CACHE_DIR  = Path(_xdg_cache) / "bashbasicsbyvk"
SOCK_PATH  = CONFIG_DIR / "daemon.sock"
PID_FILE   = CONFIG_DIR / "daemon.pid"
LOCK_FILE  = CONFIG_DIR / "daemon.lock"
LOG_FILE   = CACHE_DIR  / "daemon.log"
CACHE_VER  = 4  # bumped: schema now includes recursive subcache population

CONFIG_DIR.mkdir(parents=True, exist_ok=True)
CACHE_DIR.mkdir(parents=True, exist_ok=True)

# ── Shared thread pool ─────────────────────────────────────────────────────────
# 64 workers: pure I/O-bound work on Termux (scandir+stat syscalls).
# The GIL is released during I/O so threads genuinely run in parallel here.
_POOL_WORKERS = 64
_pool = ThreadPoolExecutor(max_workers=_POOL_WORKERS, thread_name_prefix="bvk")

