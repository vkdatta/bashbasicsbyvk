def _icon_type(name: str, is_dir: bool, mode: int) -> str:
    if name.endswith(".shortcut"):
        return "shortcut"
    if is_dir:
        return "dir"
    lo = name.lower()
    for m in _ARCHIVE_MULTI:
        if lo.endswith(m):
            return "archive"
    dot = lo.rfind(".")
    ext = lo[dot:] if dot >= 0 else ""
    if ext in _ARCHIVE_EXT:  return "archive"
    if ext in _IMAGE_EXT:    return "image"
    if ext in _PLUGIN_EXT:   return "plugin"
    is_exec = bool(mode & (stat_mod.S_IXUSR | stat_mod.S_IXGRP | stat_mod.S_IXOTH))
    if ext in _EXEC_EXT or is_exec:  return "exec"
    return "plain"

# ── Cache I/O ──────────────────────────────────────────────────────────────────

def _cache_path(dirpath: str) -> Path:
    h = hashlib.sha1(dirpath.encode()).hexdigest()
    return CACHE_DIR / f"{h}.json"

def _cache_load(dirpath: str):
    try:
        with open(_cache_path(dirpath)) as f:
            d = json.load(f)
        if d.get("v") != CACHE_VER:
            return None
        return d
    except Exception:
        return None

def _cache_save(dirpath: str, data: dict):
    p   = _cache_path(dirpath)
    tmp = str(p) + ".tmp"
    try:
        with open(tmp, "w") as f:
            json.dump(data, f, separators=(",", ":"))
        os.replace(tmp, p)
    except Exception as e:
        _log(f"cache save error: {e}")

def _cache_invalidate(dirpath: str):
    try:
        _cache_path(dirpath).unlink(missing_ok=True)
    except Exception:
        pass

# ── Progress state (shared across recursive workers) ──────────────────────────

class _ProgressState:
    """
    Thread-safe counters updated by every worker at every file/folder.
    No estimates — only exact counts of what has actually been seen.
    """
    __slots__ = ("lock", "files", "folders", "bytes", "callback", "_last_t")

    def __init__(self, callback):
        self.lock     = threading.Lock()
        self.files    = 0
        self.folders  = 0
        self.bytes    = 0
        self.callback = callback
        self._last_t  = 0.0

    def tick_file(self, size: int):
        if self.callback is None:
            return
        with self.lock:
            self.files += 1
            self.bytes += size
            self._fire()

    def tick_folder(self):
        if self.callback is None:
            return
        with self.lock:
            self.folders += 1
            self._fire()

    def _fire(self):
        # Throttle to max one update per 100 ms to avoid socket flood
        now = time.monotonic()
        if now - self._last_t < 0.1:
            return
        self._last_t = now
        try:
            self.callback(self.files, self.folders, self.bytes)
        except Exception:
            pass

# ── Core recursive scanner ─────────────────────────────────────────────────────

def _walk_dir(dirpath: str, dir_mtime: float, ps: _ProgressState) -> dict:
    """
    Scan one directory level.  For each subdirectory found, submit a new
    task to the shared pool so all branches of the tree run in parallel.

    Returns the cache data dict for `dirpath`.  Also writes a cache file
    for every subdirectory it discovers — so entering any child directory
    later is an instant cache hit with zero re-scan.

    This is the key architectural fix: ONE scan populates caches for the
    entire subtree, not just the single directory requested.
    """
    entries  = []
    sub_futs = []   # futures for child directories

    try:
        raw = list(os.scandir(dirpath))
    except PermissionError:
        raw = []
    except Exception as ex:
        _log(f"scandir {dirpath}: {ex}")
        raw = []

    for e in raw:
        try:
            st     = e.stat(follow_symlinks=True)
            is_dir = e.is_dir(follow_symlinks=True)
            mode   = st.st_mode
            mtime  = int(st.st_mtime)

            if is_dir and not e.is_symlink():
                # Submit child dir to pool — parallel recursive walk
                sub_dm = st.st_mtime
                fut = _pool.submit(_walk_dir, e.path, sub_dm, ps)
                sub_futs.append((e, fut, mtime, mode))
                ps.tick_folder()
            else:
                size = st.st_size
                icon = _icon_type(e.name, is_dir, mode)
                entries.append({
                    "p": e.path,
                    "n": e.name,
                    "d": is_dir,
                    "s": size,
                    "m": mtime,
                    "c": -1,
                    "t": icon,
                })
                ps.tick_file(size)

        except Exception:
            pass

    # Collect child dir results
    for e, fut, mtime, mode in sub_futs:
        try:
            child_data = fut.result()
            child_entries = child_data.get("entries", [])
            # Immediate children count = entries in the child's own listing
            children = len(child_entries)
            # Total recursive size = sum of all sizes in child's entries
            # (each dir entry already has its full recursive size stored)
            size = sum(ce["s"] for ce in child_entries)
            icon = _icon_type(e.name, True, mode)
            entries.append({
                "p": e.path,
                "n": e.name,
                "d": True,
                "s": size,
                "m": mtime,
                "c": children,
                "t": icon,
            })
        except Exception:
            pass

    data = {
        "v":       CACHE_VER,
        "dir":     dirpath,
        "dm":      dir_mtime,
        "ts":      time.time(),
        "entries": entries,
    }

    # Write cache for THIS directory — so any future LIST of it is instant
    _cache_save(dirpath, data)
    return data


def _scan_tree(dirpath: str, progress_cb=None) -> dict:
    """
    Entry point for a full recursive scan.  Returns the cache data for
    `dirpath`; all subdirectory caches are written as a side effect.
    """
    try:
        dir_mtime = os.stat(dirpath).st_mtime
    except Exception:
        dir_mtime = 0.0

    ps = _ProgressState(progress_cb)
    ps.tick_folder()  # count the root itself

    return _walk_dir(dirpath, dir_mtime, ps)

# ── inotify (Linux) ────────────────────────────────────────────────────────────

_inotify_fd   = -1
_wd_to_dir    = {}
_dir_to_wd    = {}
_dirty        = set()
_inotify_lock = threading.Lock()

_IN_CREATE      = 0x00000100
_IN_DELETE      = 0x00000200
_IN_MOVED_FROM  = 0x00000040
_IN_MOVED_TO    = 0x00000080
_IN_ATTRIB      = 0x00000004
_IN_CLOSE_WRITE = 0x00000008
_IN_MASK        = (_IN_CREATE | _IN_DELETE | _IN_MOVED_FROM |
                   _IN_MOVED_TO | _IN_ATTRIB | _IN_CLOSE_WRITE)
_INOTIFY_HDR    = struct.Struct("iIII")
_INOTIFY_HDR_SZ = _INOTIFY_HDR.size

def _inotify_init():
    try:
        import ctypes
        _libc = ctypes.CDLL(None)
        fd = _libc.inotify_init()
        return int(fd)
    except Exception:
        return -1

def _inotify_add(dirpath: str):
    if _inotify_fd < 0:
        return
    try:
        import ctypes
        _libc = ctypes.CDLL(None)
        _libc.inotify_add_watch.restype = ctypes.c_int
        _libc.inotify_add_watch.argtypes = [ctypes.c_int, ctypes.c_char_p, ctypes.c_uint32]
        wd = _libc.inotify_add_watch(_inotify_fd, dirpath.encode(), _IN_MASK)
        if wd >= 0:
            with _inotify_lock:
                _wd_to_dir[wd] = dirpath
                _dir_to_wd[dirpath] = wd
    except Exception as ex:
        _log(f"inotify_add_watch failed: {ex}")

def _inotify_reader():
    import select
    buf = b""
    while True:
        try:
            r, _, _ = select.select([_inotify_fd], [], [], 1.0)
            if not r:
                continue
            chunk = os.read(_inotify_fd, 65536)
            if not chunk:
                break
            buf += chunk
            while len(buf) >= _INOTIFY_HDR_SZ:
                wd, mask, cookie, name_len = _INOTIFY_HDR.unpack_from(buf)
                total = _INOTIFY_HDR_SZ + name_len
                if len(buf) < total:
                    break
                buf = buf[total:]
                with _inotify_lock:
                    dp = _wd_to_dir.get(wd)
                if dp:
                    _dirty.add(dp)
                    _log(f"dirty: {dp} (mask=0x{mask:x})")
        except Exception as ex:
            _log(f"inotify reader: {ex}")
            time.sleep(0.5)

# ── Per-directory scan locks ───────────────────────────────────────────────────

_scan_locks    = {}
_scan_lock_mtx = threading.Lock()

def _scan_lock(dirpath: str) -> threading.Lock:
    with _scan_lock_mtx:
        if dirpath not in _scan_locks:
            _scan_locks[dirpath] = threading.Lock()
        return _scan_locks[dirpath]

# ── Core: get directory data (cache-first, rebuild on miss/dirty) ──────────────

def _get_dir_data(dirpath: str, progress_cb=None) -> dict:
    """
    Returns cache data for dirpath.

    On cache HIT  → instant, no I/O beyond reading one JSON file.
    On cache MISS → _scan_tree() walks the entire subtree, populating
                    caches for every directory it visits.  All subsequent
                    requests for any child directory will be cache hits.
    """
    is_dirty = dirpath in _dirty
    if is_dirty:
        _dirty.discard(dirpath)
        _cache_invalidate(dirpath)

    if not is_dirty:
        cached = _cache_load(dirpath)
        if cached is not None:
            try:
                cur_mtime = os.stat(dirpath).st_mtime
                if abs(cur_mtime - cached.get("dm", 0)) < 1.0:
                    _inotify_add(dirpath)
                    return cached
            except Exception:
                pass

    lock = _scan_lock(dirpath)
    with lock:
        # Double-check after acquiring the lock (another thread may have
        # just finished scanning and written the cache)
        if not is_dirty:
            cached = _cache_load(dirpath)
            if cached is not None:
                try:
                    cur_mtime = os.stat(dirpath).st_mtime
                    if abs(cur_mtime - cached.get("dm", 0)) < 1.0:
                        _inotify_add(dirpath)
                        return cached
                except Exception:
                    pass

        _log(f"full recursive scan: {dirpath}")
        data = _scan_tree(dirpath, progress_cb=progress_cb)
        # Register inotify watches for all dirs we just cached
        _inotify_add(dirpath)
        return data

# ── Request handlers ───────────────────────────────────────────────────────────

def _handle_list(dirpath: str, show_hidden: bool, wfile):
    if not os.path.isdir(dirpath):
        wfile.write(b"ERROR:not a directory\nEND\n")
        return

    _last_progress_t = [0.0]

    def _progress(files: int, folders: int, byte_count: int):
        now = time.monotonic()
        if now - _last_progress_t[0] < 0.1:
            return
        _last_progress_t[0] = now
        try:
            wfile.write(
                f"PROGRESS:{files}:{folders}:{byte_count}\n".encode()
            )
            wfile.flush()
        except Exception:
            pass

    data    = _get_dir_data(dirpath, progress_cb=_progress)
    entries = data.get("entries", [])

    out = []
    for e in entries:
        if not show_hidden and e["n"].startswith("."):
            continue
        out.append(f"{e['p']}|{e['s']}|{e['m']}|{e['c']}|{e['t']}\n".encode())

    for line in out:
        wfile.write(line)
    wfile.write(b"END\n")
    wfile.flush()

def _handle_client(conn: socket.socket):
    try:
        rfile = conn.makefile("rb")
        wfile = conn.makefile("wb")
        raw   = rfile.readline()
        if not raw:
            return
        parts = raw.decode().strip().split("\t")
        cmd   = parts[0] if parts else ""

        if cmd == "LIST" and len(parts) >= 2:
            dirpath     = parts[1]
            show_hidden = (parts[2] == "1") if len(parts) >= 3 else False
            _handle_list(dirpath, show_hidden, wfile)

        elif cmd == "INVALIDATE" and len(parts) >= 2:
            _cache_invalidate(parts[1])
            _dirty.discard(parts[1])
            wfile.write(b"OK\n")
            wfile.flush()

        elif cmd == "PING":
            wfile.write(b"PONG\n")
            wfile.flush()

        elif cmd == "QUIT":
            wfile.write(b"BYE\n")
            wfile.flush()
            os.kill(os.getpid(), signal.SIGTERM)

        else:
            wfile.write(b"ERROR:unknown command\n")
            wfile.flush()

    except Exception as ex:
        _log(f"client handler: {ex}")
    finally:
        try: conn.close()
        except Exception: pass

# ── Logging ────────────────────────────────────────────────────────────────────

_log_lock = threading.Lock()

def _log(msg: str):
    ts   = time.strftime("%H:%M:%S")
    line = f"[{ts}] {msg}\n"
    with _log_lock:
        try:
            with open(LOG_FILE, "a") as f:
                f.write(line)
        except Exception:
            pass

# ── Daemon startup ─────────────────────────────────────────────────────────────

def _run_daemon():
    lock_fd = open(LOCK_FILE, "w")
    try:
        fcntl.flock(lock_fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        sys.exit(0)

    with open(PID_FILE, "w") as f:
        f.write(str(os.getpid()) + "\n")

    try: SOCK_PATH.unlink()
    except FileNotFoundError: pass

    global _inotify_fd
    _inotify_fd = _inotify_init()
    if _inotify_fd >= 0:
        t = threading.Thread(target=_inotify_reader, daemon=True, name="inotify")
        t.start()
        _log("inotify active")
    else:
        _log("inotify unavailable — using mtime validation")

    def _cleanup(sig, frame):
        _log("shutting down")
        try: SOCK_PATH.unlink()
        except Exception: pass
        try: PID_FILE.unlink()
        except Exception: pass
        try: lock_fd.close()
        except Exception: pass
        sys.exit(0)

    signal.signal(signal.SIGTERM, _cleanup)
    signal.signal(signal.SIGINT,  _cleanup)

    srv = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    srv.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
    srv.bind(str(SOCK_PATH))
    os.chmod(SOCK_PATH, 0o600)
    srv.listen(64)
    srv.settimeout(1.0)

    _log(f"listening on {SOCK_PATH} (pid {os.getpid()}) — {_POOL_WORKERS} scan workers")

    try:
        while True:
            try:
                conn, _ = srv.accept()
            except socket.timeout:
                continue
            except OSError:
                break
            t = threading.Thread(
                target=_handle_client, args=(conn,), daemon=True
            )
            t.start()
    finally:
        try: srv.close()
        except Exception: pass
        _cleanup(None, None)

# ── Client mode ────────────────────────────────────────────────────────────────

def _fmt_bytes(n: int) -> str:
    for unit in ("B", "KB", "MB", "GB", "TB"):
        if n < 1024 or unit == "TB":
            return f"{n:.1f} {unit}" if unit != "B" else f"{n} B"
        n /= 1024

def _draw_progress(files: int, folders: int, byte_count: int):
    """
    Progress bar — no percentage, no estimate.
    Shows exact counts of files and folders seen so far plus bytes scanned.

    Format:  Scanning…  12,345 files  678 folders  4.2 GB
    """
    line = (
        f"\r\033[KScanning…  {files:,} files  {folders:,} folders"
        f"  {_fmt_bytes(byte_count)}"
    )
    sys.stderr.write(line)
    sys.stderr.flush()

def _clear_progress():
    sys.stderr.write("\r\033[K")
    sys.stderr.flush()

def _run_client(argv):
    cmd  = argv[0] if argv else "PING"
    args = argv[1:]

    sock_str = str(SOCK_PATH)
    if not os.path.exists(sock_str):
        print("ERROR:daemon not running", flush=True)
        sys.exit(1)

    showed_progress = False

    try:
        s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        s.settimeout(300.0)   # 5-min max for very large first scans
        s.connect(sock_str)

        msg = (cmd + "".join(f"\t{a}" for a in args) + "\n").encode()
        s.sendall(msg)

        out  = sys.stdout.buffer
        buf  = b""
        done = False

        while not done:
            chunk = s.recv(65536)
            if not chunk:
                break
            buf += chunk

            while b"\n" in buf:
                nl      = buf.index(b"\n")
                line    = buf[:nl + 1]
                buf     = buf[nl + 1:]
                decoded = line.decode(errors="replace")

                if decoded.startswith("PROGRESS:"):
                    # PROGRESS:<files>:<folders>:<bytes>
                    try:
                        parts = decoded.strip().split(":")
                        _draw_progress(int(parts[1]), int(parts[2]), int(parts[3]))
                        showed_progress = True
                    except Exception:
                        pass
                else:
                    if showed_progress:
                        _clear_progress()
                        showed_progress = False
                    out.write(line)
                    out.flush()

                stripped = decoded.strip()
                if stripped in ("END", "OK", "PONG", "BYE") or \
                        stripped.startswith("ERROR:"):
                    done = True
                    break

        if showed_progress:
            _clear_progress()

        if buf:
            out.write(buf)
            out.flush()

        s.close()

    except socket.timeout:
        if showed_progress:
            _clear_progress()
        print("ERROR:timeout", flush=True)
        sys.exit(1)

    except Exception as ex:
        if showed_progress:
            _clear_progress()
        try:
            Path(sock_str).unlink(missing_ok=True)
        except Exception:
            pass
        print(f"ERROR:{ex}", flush=True)
        sys.exit(1)

# ── Entry point ────────────────────────────────────────────────────────────────

if __name__ == "__main__":
    if len(sys.argv) >= 2 and sys.argv[1] == "--daemon":
        _run_daemon()
    else:
        _run_client(sys.argv[1:])
